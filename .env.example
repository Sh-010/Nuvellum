# Nuvellum environment variables. NAMES ONLY: never commit real values.
# Copy to .env (gitignored) for local runs; in GitHub use Actions secrets (keys)
# and variables (non-secret settings); in n8n use the credential store.

# --- Site ------------------------------------------------------------------
SITE_URL=https://nuvellum.vercel.app

# --- Publication gate (GitHub Actions *variables*) ------------------------------
# NUVELLUM_AUTOPUBLISH=off            # "on" lets the gate merge cleared stories
# DISTRIBUTION_LIVE=off               # "on" lets distribution actually post

# --- Model providers (secrets) --------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional default models (override per role below)
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5-mini

# --- Role -> ordered provider chain (first available wins, then next) ------
# Draft and verify should use DIFFERENT providers/models for independence.
# NUVELLUM_ROLE_DRAFT=gemini:gemini-2.5-flash
# NUVELLUM_ROLE_REVIEW=anthropic:claude-sonnet-5,gemini:gemini-2.5-pro
# NUVELLUM_ROLE_VERIFY=anthropic:claude-sonnet-5,openai:gpt-5-mini
# NUVELLUM_ROLE_SOCIAL=gemini:gemini-2.5-flash
# NUVELLUM_ROLE_SHORTS_SCRIPT=gemini:gemini-2.5-flash
# NUVELLUM_ROLE_SHORTS_VERIFY=anthropic:claude-sonnet-5

# --- Text-to-speech for Shorts ----------------------------------------------
# NUVELLUM_TTS=elevenlabs,openai,google,piper,espeak,silent
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
GOOGLE_TTS_API_KEY=
# PIPER_MODEL=/absolute/path/to/en_GB-voice.onnx   # free local neural TTS (pip install piper-tts)
# ESPEAK_VOICE=en-gb

# --- Social platforms (all optional; unset = adapter disabled) ----------------
X_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY=private

# --- Local tooling (optional) --------------------------------------------------
# CHROMIUM_PATH=        # otherwise playwright-core's Chromium (npx playwright-core install chromium)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
