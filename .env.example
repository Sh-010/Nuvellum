# Nuvellum environment variables. NAMES ONLY: never commit real values.
# Copy to .env (gitignored) for local runs; in GitHub use Actions secrets (keys)
# and variables (non-secret settings); in n8n use the credential store.

# --- Site ------------------------------------------------------------------
SITE_URL=https://nuvellum.vercel.app
# Optional reader analytics; leave unset until privacy/consent treatment is ready.
# NUVELLUM_GA4_ID=G-XXXXXXXXXX

# --- Publication gate (GitHub Actions *variables*) ------------------------------
# NUVELLUM_AUTOPUBLISH=off            # "on" lets the gate merge cleared stories

# Model-provider, TTS and social-platform variables belong to the engines on
# branch engines/distribution-shorts and are not used in production.

# --- Optional local Shorts/Reels rendering --------------------------------
# NUVELLUM_TTS=piper,espeak,silent
# PIPER_MODEL=/path/to/local-voice.onnx
# ESPEAK_VOICE=en-gb
# ESPEAK_RATE=158
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# CHROMIUM_PATH=/path/to/chromium

# --- Admin dashboard (/admin) — Vercel environment variables, see docs/ADMIN.md ---
# NUVELLUM_ADMIN_PASSWORD=          # >= 16 characters
# NUVELLUM_ADMIN_SESSION_SECRET=    # >= 32 random characters
# NUVELLUM_GITHUB_TOKEN=            # fine-grained PAT, Sh-010/Nuvellum only: Contents RW, Pull requests RW, Actions R

# --- The Nuvellum Brief (sign-ups) — Vercel environment variables, see docs/BRIEF.md ---
# Until all three are set, the sign-up form answers "not open yet" and stores nothing.
# NUVELLUM_BRIEF_SECRET=…        # 32+ random characters; signs unsubscribe links and keys records
# KV_REST_API_URL=…              # added automatically by Vercel Marketplace → Upstash for Redis
# KV_REST_API_TOKEN=…            # (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
