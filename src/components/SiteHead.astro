---
const {
  title='Nuvellum',
  description='Beyond the headline.',
  image='/images/world.svg',
  canonical,
  type='website',
  publishedTime,
  modifiedTime,
  author
} = Astro.props;
const site = Astro.site ?? new URL('https://nuvellum.vercel.app');
const url = canonical ? new URL(canonical, site) : new URL(Astro.url.pathname, site);
// '' = a text-led story with no image: no share image rather than unrelated art.
const imageUrl = image ? new URL(image, site) : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" sizes="any" />\n<link rel="shortcut icon" href="/favicon.svg?v=2" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="alternate" type="application/rss+xml" title="Nuvellum RSS" href="/rss.xml" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Nuvellum" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta name="author" content={author} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
<meta name="theme-color" content="#6d1720" />
