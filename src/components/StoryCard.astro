---
const { article, variant = 'card', showDek = true, index } = Astro.props;
const displayDate = new Date(article.date + 'T00:00:00Z').toLocaleDateString('en-GB', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
});
---
<article class:list={['int-story', `int-story--${variant}`]} data-reveal>
  {index !== undefined && <div class="int-story-index" aria-hidden="true">{String(index).padStart(2, '0')}</div>}
  <a class="int-story-media" href={`/article/${article.slug}`} tabindex="-1">
    <img src={article.image} alt={article.imageAlt || ''} loading={variant === 'lead' ? 'eager' : 'lazy'} />
  </a>
  <div class="int-story-copy">
    <div class="int-story-kicker">{article.section} · {article.type}</div>
    <h2><a href={`/article/${article.slug}`}>{article.title}</a></h2>
    {showDek && <p>{article.dek}</p>}
    <div class="int-story-meta">{displayDate} · {article.readingTime} read</div>
  </div>
</article>
