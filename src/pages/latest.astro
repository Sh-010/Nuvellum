---
import InteriorShell from '../components/InteriorShell.astro';
import StoryCard from '../components/StoryCard.astro';
import { getArticles, slugify } from '../lib/articles';

const articles = await getArticles();
const sections = [...new Map(articles.map(article => [slugify(article.section), article.section])).entries()];
---
<InteriorShell title="Latest — Nuvellum" description="The latest published reporting, analysis and ideas from Nuvellum." active="latest">
  <div class="int-wrap int-page">
    <header class="int-page-head" data-reveal>
      <div>
        <div class="int-page-kicker">Chronological edition</div>
        <h1 class="int-page-title">Latest</h1>
        <p class="int-page-dek">Every published Nuvellum story in reverse chronological order, without popularity weighting.</p>
      </div>
      <div class="int-page-note">{articles.length} published {articles.length === 1 ? 'story' : 'stories'} in the current archive.</div>
    </header>

    <div class="int-filters" role="group" aria-label="Filter latest stories by section">
      <button class="int-filter active" type="button" data-filter="all">All</button>
      {sections.map(([key,label]) => <button class="int-filter" type="button" data-filter={key}>{label}</button>)}
    </div>

    <div class="int-feed" id="latestFeed">
      {articles.map((article,index) => (
        <div class="int-latest-row" data-section={slugify(article.section)}>
          <StoryCard article={article} variant="row" index={index + 1} />
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-filter]')];
      const rows = [...document.querySelectorAll('.int-latest-row')];
      buttons.forEach(button => button.addEventListener('click', () => {
        const key = button.dataset.filter;
        buttons.forEach(item => item.classList.toggle('active', item === button));
        rows.forEach(row => { row.hidden = key !== 'all' && row.dataset.section !== key; });
      }));
    })();
  </script>
</InteriorShell>
