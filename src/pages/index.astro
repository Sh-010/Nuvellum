---
import SiteHead from '../components/SiteHead.astro';
import '../styles/global.css';
import { getArticles, slugify } from '../lib/articles';

const articles = await getArticles();
const bySlug = Object.fromEntries(articles.map(a => [a.slug, a]));
const pick = (slug) => bySlug[slug];

const lead = pick('world-in-motion');
const side = [pick('ai-infrastructure'), pick('patient-capital'), pick('prestige-media')].filter(Boolean);
const latest = [pick('sports-media-war'), pick('film-spectacle'), pick('smaller-studios'), pick('observatories')].filter(Boolean);
const worldFeatures = [pick('power-distributed'), pick('megacity-power')].filter(Boolean);
const worldStack = [pick('industrial-race'), pick('supply-chains-foreign-policy'), pick('young-cities-investment'), pick('regional-power-logistics')].filter(Boolean);
const screen = [pick('film-spectacle'), pick('global-anime'), pick('smaller-studios')].filter(Boolean);
const opinions = [pick('too-much-information'), pick('internet-flattened-taste'), pick('seriousness-fashionable')].filter(Boolean);
const jsData = articles.map(({Content,...a}) => a);
const nav = ['World','Business','Technology','Science','Crime','Sports','Culture','Film & TV','Anime','Gaming','Opinion'];
---
<!doctype html>
<html lang="en">
<head>
  <SiteHead title="Nuvellum — Beyond the headline." description="Independent international reporting, analysis and culture coverage." image={lead?.image || '/images/world.svg'} />
</head>
<body>
<div class="topline"></div>
<div class="home-progress" id="progress"></div>

<div class="utility-shell">
  <div class="utility wrap">
    <span id="today">{new Date().toLocaleDateString('en-GB',{weekday:'long',year:'numeric',month:'long',day:'numeric'})}</span>
    <span class="utility-center">Global Edition</span>
    <div class="utility-actions">
      <button class="mini-btn" id="themeBtn">Night</button>
      <button class="mini-btn" id="savedBtn">Saved <span class="saved-count" id="savedCount">0</span></button>
      <button class="mini-btn" id="searchBtn">Search</button>
    </div>
  </div>
</div>

<header>
  <div class="mast wrap">
    <a class="brand" href="/" aria-label="Nuvellum home">{[...'NUVELLUM'].map(x => <span>{x}</span>)}</a>
    <div class="tag">Beyond the headline.</div>
    <div class="mast-rule"></div>
  </div>
  <div class="nav-shell">
    <nav class="nav wrap">{nav.map(n => <a href={n==='Film & TV'||n==='Anime'||n==='Gaming' ? '#screen' : n==='Opinion' ? '#opinion' : '#'+slugify(n)}>{n}</a>)}</nav>
  </div>
</header>

<div class="panel" id="searchPanel"><div class="panel-in"><div class="panel-head"><strong>Search Nuvellum</strong><button class="close" data-close>×</button></div><input class="search-input" id="searchInput" placeholder="Search stories, topics, sections…"/><div id="searchResults"><p class="dek">Start typing to search Nuvellum.</p></div></div></div>
<div class="panel" id="savedPanel"><div class="panel-in"><div class="panel-head"><strong>Your reading list</strong><button class="close" data-close>×</button></div><div id="savedResults"></div></div></div>
<div class="drawer" id="drawer"><div class="drawer-in"><div class="panel-head"><strong>NUVELLUM</strong><button class="close" data-close>×</button></div><div class="kicker" id="drawerKicker"></div><h2 class="drawer-title" id="drawerTitle"></h2><p class="drawer-dek" id="drawerDek"></p><div class="drawer-actions"><a class="btn-outline primary" id="drawerRead">Read story</a><button class="btn-outline" id="drawerSave">Save</button></div></div></div>
<div class="scrim" id="scrim"></div><div class="toast" id="toast"></div>

<main>
  {lead && <section class="breaking wrap"><span class="live">LIVE</span><a id="ticker" href={'/article/'+lead.slug}>Markets, diplomacy and technology reshape a volatile global week</a><span class="ticker-time">Latest</span></section>}

  {lead && <section class="hero wrap">
    <article class="lead motion reveal" tabindex="0" data-story={lead.slug}>
      <a class="media" href={'/article/'+lead.slug}><span class="quick-chip">Open story</span><img src={lead.image} alt={lead.imageAlt}/></a>
      <div class="kicker">WORLD · ANALYSIS</div>
      <h1><a href={'/article/'+lead.slug}>{lead.title}</a></h1>
      <p class="dek">From trade routes to technology and culture, the most important shifts are happening beyond the obvious headlines.</p>
      <div class="meta">By Nuvellum Global Desk · 12 min read</div>
    </article>
    <aside class="hero-side">
      {side.map(a => <article class="side motion reveal" tabindex="0" data-story={a.slug}>
        <a class="media" href={'/article/'+a.slug}><span class="quick-chip">Open story</span><img src={a.image} alt={a.imageAlt}/></a>
        <div class="kicker">{a.section}</div><h2><a href={'/article/'+a.slug}>{a.title}</a></h2><p>{a.dek}</p>
      </article>)}
    </aside>
  </section>}

  <section class="latest" id="technology"><div class="wrap">
    <div class="row-head"><h2>Latest</h2><div class="filters"><button class="filter active" data-filter="all">All</button><button class="filter" data-filter="world">World</button><button class="filter" data-filter="technology">Tech</button><button class="filter" data-filter="film-tv">Film</button><button class="filter" data-filter="gaming">Gaming</button><button class="filter" data-filter="sports">Sports</button></div></div>
    <div class="latest-grid">{latest.map(a => <article class="latest-card motion" data-category={slugify(a.section)} data-story={a.slug} tabindex="0"><div class="kicker">{a.section}</div><h3><a href={'/article/'+a.slug}>{a.title}</a></h3><p>{a.dek}</p></article>)}</div>
  </div></section>

  <section class="section wrap" id="world">
    <div class="section-head"><h2>World</h2><button class="section-toggle" data-collapse>Hide</button></div>
    <div class="section-body"><div class="grid3">
      {worldFeatures.map(a => <article class="story-card motion reveal" tabindex="0" data-story={a.slug}><a class="media" href={'/article/'+a.slug}><img src={a.image} alt={a.imageAlt}/></a><div class="kicker">{a.type}</div><h3><a href={'/article/'+a.slug}>{a.title}</a></h3><p>{a.dek}</p></article>)}
      <div class="stack reveal">{worldStack.map(a => <article data-story={a.slug} tabindex="0"><div class="kicker">{a.tags?.[0] || a.section}</div><h3>{a.title}</h3></article>)}</div>
    </div></div>
  </section>

  <section class="dark-section" id="screen"><div class="wrap">
    <div class="section-head"><h2>Screen & Play</h2><a href="/section/anime">Film · Anime · Gaming</a></div>
    <div class="culture">
      {screen.map((a,i) => <article class={(i===0?'feature ':'mini ')+'motion reveal'} tabindex="0" data-story={a.slug}><a class="media" href={'/article/'+a.slug}><span class="quick-chip">Quick view</span><img src={a.image} alt={a.imageAlt}/></a><div class="kicker">{a.section}</div><h3><a href={'/article/'+a.slug}>{a.title}</a></h3>{i===0 && <p>{a.dek}</p>}</article>)}
    </div>
  </div></section>

  <section class="section wrap" id="opinion">
    <div class="section-head"><h2>Opinion & Ideas</h2><a href="/section/opinion">All columns</a></div>
    <div class="opinions">{opinions.map((a,i) => <article class="opinion motion reveal" tabindex="0" data-story={a.slug}><div class="avatar">{['NS','AR','LM'][i]}</div><div><div class="kicker">{a.type}</div><h3>{a.title}</h3><small>By {a.author}</small></div></article>)}</div>
  </section>

  <section class="newsletter"><div class="newsletter-in wrap">
    <div><div class="kicker" style="color:#f1d8dc">THE NUVELLUM BRIEF</div><h2>One intelligent read of the world.<br/>Once a day.</h2></div>
    <form class="signup" id="signup"><input id="email" type="email" required placeholder="you@example.com"/><button>Join the brief</button><div class="signup-msg" id="signupMsg">No noise. Unsubscribe anytime.</div></form>
  </div></section>
</main>

<footer class="footer"><div class="wrap">
  <div class="footer-brand">NUVELLUM</div><div class="tag">Beyond the headline.</div>
  <div class="footer-grid">
    <div><h4>Sections</h4><a href="#world">World</a><a href="/section/business">Business</a><a href="#technology">Technology</a><a href="/section/sports">Sports</a></div>
    <div><h4>Culture</h4><a href="#screen">Film & TV</a><a href="#screen">Anime</a><a href="#screen">Gaming</a><a href="#opinion">Opinion</a></div>
    <div><h4>Nuvellum</h4><a href="/about">About</a><a href="/standards">Editorial Standards</a><a href="/corrections">Corrections</a><a href="/contact">Contact</a></div>
    <div><h4>Business</h4><a href="/advertise">Advertise</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
  </div>
  <div class="footer-bottom">© 2026 Nuvellum. Independent international media.</div>
</div></footer>

<button class="backtop" id="backtop">↑</button>
<script id="story-data" type="application/json" set:html={JSON.stringify(jsData)}></script>
<script is:inline src="/js/home.js"></script>
</body></html>