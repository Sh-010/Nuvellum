---
import InteriorShell from '../../components/InteriorShell.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getArticles } from '../../lib/articles';

export async function getStaticPaths() {
  return 'abcdefghijklmnopqrstuvwxyz'.split('').map(letter => ({ params: { letter } }));
}

const letter = String(Astro.params.letter || '').toLowerCase();
const articles = (await getArticles()).filter(article => article.title.trim().toLowerCase().startsWith(letter));
const upper = letter.toUpperCase();
---
<InteriorShell
  title={`Headlines beginning with ${upper} — Nuvellum`}
  description={`Published Nuvellum headlines beginning with the letter ${upper}.`}
>
  <div class="int-wrap int-page">
    <header data-reveal>
      <div class="int-page-kicker">A–Z headline archive</div>
      <h1 class="int-letter">{upper}</h1>
      <nav class="int-alpha" aria-label="Browse headlines by letter">
        {'abcdefghijklmnopqrstuvwxyz'.split('').map(item => (
          <a class:list={[item === letter && 'active']} href={`/headlines/${item}`} aria-current={item === letter ? 'page' : undefined}>{item.toUpperCase()}</a>
        ))}
      </nav>
    </header>

    <div class="int-section-label"><h2>{articles.length ? `Headlines beginning with ${upper}` : `No ${upper} headlines yet`}</h2><span>{articles.length} results</span></div>
    {articles.length ? (
      <div class="int-feed">{articles.map((article,index)=><StoryCard article={article} variant="row" index={index+1}/>)}</div>
    ) : (
      <div class="int-empty">No published Nuvellum headlines currently begin with {upper}.</div>
    )}
  </div>
</InteriorShell>
