---
// Nuvellum editorial control room. A static shell with no data and no secrets: everything it shows
// comes from /api/admin, which authenticates every request on its own. Not linked anywhere, excluded
// from the sitemap and robots, and marked noindex; that is hygiene, not the protection.
import interiorCss from '../styles/interior.css?raw';
import articleCss from '../styles/article.css?raw';
const previewCss = JSON.stringify(interiorCss + '\n' + articleCss).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow, noarchive" />
<meta name="referrer" content="same-origin" />
<title>Nuvellum — Editorial desk</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<style is:global>
@font-face{font-family:'Newsreader';font-style:normal;font-weight:300 700;font-display:swap;src:url(/fonts/newsreader-normal-latin.woff2) format('woff2')}
@font-face{font-family:'Newsreader';font-style:italic;font-weight:300 700;font-display:swap;src:url(/fonts/newsreader-italic-latin.woff2) format('woff2')}
:root{--paper:#f8f4ec;--paper2:#fbf8f2;--card:#fffdf8;--ink:#1f1a16;--muted:#6b6259;--line:#ddd3c3;--hair:rgba(96,74,52,.2);--wine:#661227;--wine2:#54101f;--ok:#2f5d3a;--warn:#8a5a00;--bad:#8e1834;--serif:'Newsreader',Georgia,'Times New Roman',serif;--sans:Arial,Helvetica,sans-serif}
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--serif);-webkit-font-smoothing:antialiased}
a{color:var(--wine)}
button,input,select,textarea{font:inherit;color:inherit}
[hidden]{display:none!important}
.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.86em}
.eyebrow{font-family:var(--sans);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--wine)}
.btn{border:1px solid var(--ink);background:transparent;padding:9px 14px;border-radius:2px;cursor:pointer;font-family:var(--sans);font-size:13px;letter-spacing:.02em}
.btn:hover{background:rgba(102,18,39,.06)}
.btn.primary{background:var(--wine);border-color:var(--wine);color:#f6efe4}
.btn.primary:hover{background:var(--wine2)}
.btn.danger{border-color:var(--bad);color:var(--bad)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.btn.small{padding:5px 9px;font-size:12px}
.field{display:grid;gap:5px;margin:0 0 14px}
.field label,.label{font-family:var(--sans);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;gap:10px}
.field input[type=text],.field input[type=url],.field input[type=password],.field input[type=datetime-local],.field input[type=date],.field select,.field textarea{width:100%;border:1px solid var(--line);background:var(--card);padding:9px 10px;border-radius:2px}
.field textarea{resize:vertical;min-height:70px}
.field input:focus,.field select:focus,.field textarea:focus{outline:2px solid rgba(102,18,39,.35);outline-offset:0}
.hint{font-family:var(--sans);font-size:12px;color:var(--muted)}
.count.over{color:var(--bad);font-weight:700}
/* login */
.login{min-height:100vh;display:grid;place-items:center;padding:24px}
.login-card{width:min(420px,100%);border-top:3px solid var(--wine);background:var(--card);padding:34px 30px;box-shadow:0 8px 24px rgba(56,39,25,.08)}
.mark{font-size:44px;line-height:1;color:var(--wine);font-weight:600}.mark span{font-size:.45em;vertical-align:top}
.login h1{font-weight:400;font-size:28px;margin:12px 0 4px}
.msg{font-family:var(--sans);font-size:13px;margin-top:10px;min-height:18px}
.msg.bad{color:var(--bad)}.msg.ok{color:var(--ok)}
/* app */
.bar{position:sticky;top:0;z-index:5;background:var(--paper2);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:18px;padding:10px 20px;flex-wrap:wrap}
.bar .brand{display:flex;align-items:baseline;gap:10px;font-size:22px}
.bar .brand .mark{font-size:28px}
.tabs{display:flex;gap:4px;flex-wrap:wrap}
.tab{border:0;background:none;padding:8px 12px;font-family:var(--sans);font-size:13px;letter-spacing:.04em;cursor:pointer;border-bottom:2px solid transparent}
.tab[aria-selected=true]{border-color:var(--wine);color:var(--wine)}
.bar .spacer{flex:1}
.who{font-family:var(--sans);font-size:12px;color:var(--muted)}
main.wrap{max-width:1500px;margin:0 auto;padding:22px 20px 60px}
h2.view-title{font-weight:400;font-size:30px;margin:0 0 4px}
.view-intro{color:var(--muted);margin:0 0 18px}
/* queue */
.columns{display:grid;grid-template-columns:repeat(5,minmax(230px,1fr));gap:14px;overflow-x:auto;padding-bottom:6px}
.col{background:var(--paper2);border:1px solid var(--line);border-top:3px solid var(--ink);min-height:120px}
.col[data-b="Ready to Publish"]{border-top-color:var(--ok)}.col[data-b="Held / Rejected"]{border-top-color:var(--bad)}.col[data-b="Pending Review"]{border-top-color:var(--wine)}
.col h3{margin:0;padding:10px 12px;font-family:var(--sans);font-size:12px;letter-spacing:.12em;text-transform:uppercase;display:flex;justify-content:space-between;border-bottom:1px solid var(--line)}
.card{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid var(--hair);background:none;padding:12px;cursor:pointer}
.card:hover{background:rgba(102,18,39,.035)}
.card .t{font-size:17px;line-height:1.2;margin:4px 0 6px}
.card .d{font-size:13.5px;color:var(--muted);line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.badges{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.badge{font-family:var(--sans);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line);padding:2px 6px;border-radius:2px;background:var(--card)}
.badge.newsroom{border-color:#6b6259}.badge.manual{border-color:var(--wine);color:var(--wine)}
.badge.sensitive{background:#f3e3e6;border-color:#d9a5b2;color:var(--bad)}
.badge.ok{color:var(--ok);border-color:#9fc0a8}.badge.bad{color:var(--bad);border-color:#d9a5b2}.badge.wait{color:var(--warn);border-color:#e0c68f}
.empty{padding:14px 12px;color:var(--muted);font-size:14px;font-style:italic}
/* list */
.filters{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 12px;align-items:end}
.filters .field{margin:0;min-width:150px}
.filters .grow{flex:1;min-width:220px}
table.list{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line)}
.list th{font-family:var(--sans);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);text-align:left;padding:9px 10px;border-bottom:1px solid var(--line)}
.list td{padding:10px;border-bottom:1px solid var(--hair);vertical-align:top;font-size:14.5px}
.list td.title{font-size:16px;line-height:1.25}
.list .actions{white-space:nowrap}
/* editor */
.editor{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:24px;align-items:start}
.panel{background:var(--card);border:1px solid var(--line);padding:18px 18px 8px;margin-bottom:16px}
.panel>h3{margin:0 0 12px;font-weight:400;font-size:20px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.toolbar{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px}
.toolbar button{border:1px solid var(--line);background:var(--paper2);padding:5px 9px;font-family:var(--sans);font-size:12.5px;cursor:pointer}
.toolbar button:hover{border-color:var(--wine)}
textarea#f-body{min-height:420px;font-family:var(--serif);font-size:17px;line-height:1.55}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--paper2);padding:3px 8px;font-family:var(--sans);font-size:12.5px}
.chip button{border:0;background:none;cursor:pointer;color:var(--bad);padding:0 2px}
.regions{display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;font-family:var(--sans);font-size:13px}
.side{position:sticky;top:70px}
.state{font-size:22px;margin:2px 0 10px}
.checks{list-style:none;margin:0 0 10px;padding:0;font-family:var(--sans);font-size:13px}
.checks li{display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-bottom:1px solid var(--hair)}
.gates{list-style:none;margin:0;padding:0;font-family:var(--sans);font-size:13px}
.gates li{padding:5px 0;display:flex;gap:8px}
.gates li::before{content:'✗';color:var(--bad);width:14px}
.gates li.ok::before{content:'✓';color:var(--ok)}
.issues{margin:0 0 12px;padding-left:18px;font-family:var(--sans);font-size:13px}
.issues.errors li{color:var(--bad)}.issues.warnings li{color:var(--warn)}
.actions-grid{display:grid;gap:8px;margin:10px 0 12px}
.imgprev{max-width:100%;max-height:220px;display:block;border:1px solid var(--line);margin:6px 0 10px;object-fit:contain;background:#eee}
.radios{display:flex;flex-wrap:wrap;gap:12px;font-family:var(--sans);font-size:13px;margin-bottom:10px}
.subtabs{display:flex;gap:4px;margin:0 0 10px}
iframe.preview{width:100%;height:78vh;border:1px solid var(--line);background:var(--paper)}
.notice{border-left:3px solid var(--wine);background:var(--paper2);padding:10px 12px;font-size:14px;margin:0 0 14px}
.notice.bad{border-color:var(--bad);background:#fbeef0}
dialog{border:1px solid var(--line);border-top:3px solid var(--wine);padding:22px;max-width:520px;width:calc(100% - 32px);background:var(--card)}
dialog::backdrop{background:rgba(20,15,10,.45)}
.sources a{word-break:break-all}
@media (max-width:1100px){.editor{grid-template-columns:1fr}.side{position:static}.columns{grid-template-columns:repeat(5,minmax(240px,1fr))}}
@media (max-width:640px){.row2,.row3{grid-template-columns:1fr}.bar{padding:8px 12px;gap:10px}main.wrap{padding:16px 12px 50px}.list thead{display:none}.list tr{display:block;border-bottom:1px solid var(--line)}.list td{display:block;border:0;padding:4px 10px}.list td.title{padding-top:12px}.columns{grid-template-columns:repeat(5,86vw)}}
</style>
</head>
<body>
<script is:inline type="application/json" id="preview-css" set:html={previewCss}></script>

<section class="login" id="login-screen" hidden>
  <form class="login-card" id="login-form" autocomplete="off">
    <div class="mark">N<span>✦</span></div>
    <h1>Editorial desk</h1>
    <p class="hint">Nuvellum staff only.</p>
    <div class="field"><label for="password">Password</label><input type="password" id="password" autocomplete="current-password" required maxlength="1024" /></div>
    <button class="btn primary" type="submit">Log in</button>
    <div class="msg" id="login-msg" role="status"></div>
  </form>
</section>

<div id="app" hidden>
  <header class="bar">
    <div class="brand"><span class="mark">N<span>✦</span></span> Editorial desk</div>
    <nav class="tabs" role="tablist">
      <button class="tab" role="tab" data-view="queue" aria-selected="true">Review Queue</button>
      <button class="tab" role="tab" data-view="list" aria-selected="false">Articles</button>
      <button class="tab" role="tab" data-view="new" aria-selected="false">+ New article</button>
    </nav>
    <span class="spacer"></span>
    <span class="who" id="session-note"></span>
    <button class="btn small" id="logout">Log out</button>
  </header>

  <main class="wrap">
    <div class="notice bad" id="global-error" hidden role="alert"></div>

    <section id="view-queue">
      <h2 class="view-title">Review Queue</h2>
      <p class="view-intro">Every story waiting for a decision: newsroom intake and manual drafts. Nothing publishes until its gates and all required checks pass.</p>
      <p><button class="btn small" id="queue-refresh">Refresh</button> <span class="hint" id="queue-note"></span></p>
      <div class="columns" id="queue-columns"></div>
    </section>

    <section id="view-list" hidden>
      <h2 class="view-title">Articles</h2>
      <p class="view-intro">Everything on the site's main branch, plus manual drafts in progress.</p>
      <div class="filters">
        <div class="field grow"><label for="q">Search</label><input type="text" id="q" placeholder="Title, author or slug" /></div>
        <div class="field"><label for="fs">Section</label><select id="fs"><option value="">All</option></select></div>
        <div class="field"><label for="ft">Type</label><select id="ft"><option value="">All</option></select></div>
        <div class="field"><label for="fst">Status</label><select id="fst"><option value="">All</option><option>published</option><option>review</option><option>draft</option></select></div>
        <div class="field"><label for="fo">Origin</label><select id="fo"><option value="">All</option><option value="manual">Manual</option><option value="automation">Newsroom</option><option value="legacy">Launch</option></select></div>
      </div>
      <div id="work-block"></div>
      <table class="list"><thead><tr><th>Title</th><th>Date</th><th>Section</th><th>Author</th><th>Status</th><th>Risk</th><th>Origin</th><th></th></tr></thead><tbody id="list-body"></tbody></table>
    </section>

    <section id="view-editor" hidden>
      <p><button class="btn small" id="back">← Back</button></p>
      <div class="notice" id="editor-notice" hidden></div>
      <div class="editor">
        <div>
          <div class="subtabs"><button class="tab" id="tab-write" aria-selected="true">Write</button><button class="tab" id="tab-preview" aria-selected="false">Preview</button></div>
          <div id="write-pane">
            <div class="panel">
              <h3>Story</h3>
              <div class="field"><label for="f-title">Headline <span class="count" id="c-title"></span></label><input type="text" id="f-title" maxlength="400" /></div>
              <div class="field"><label for="f-dek">Dek (standfirst) <span class="count" id="c-dek"></span></label><textarea id="f-dek" rows="2" maxlength="800"></textarea></div>
              <div class="field"><label for="f-slug">Slug (web address) <span class="hint" id="slug-note"></span></label><input type="text" id="f-slug" maxlength="90" spellcheck="false" /></div>
              <div class="row3">
                <div class="field"><label for="f-section">Section</label><select id="f-section"></select></div>
                <div class="field"><label for="f-type">Type</label><select id="f-type"></select></div>
                <div class="field"><label for="f-author">Author</label><input type="text" id="f-author" list="authors" maxlength="120" /><datalist id="authors"></datalist></div>
              </div>
              <div class="row2">
                <div class="field"><label for="f-date">Date</label><input type="date" id="f-date" /></div>
                <div class="field"><label for="f-published">Publish time (UTC) <span class="hint">empty = when published</span></label><input type="datetime-local" id="f-published" step="1" /></div>
              </div>
            </div>
            <div class="panel">
              <h3>Article</h3>
              <div class="toolbar" role="toolbar" aria-label="Formatting">
                <button type="button" data-md="h2" title="Section heading">H2</button>
                <button type="button" data-md="bold" title="Bold"><b>B</b></button>
                <button type="button" data-md="italic" title="Italic"><i>I</i></button>
                <button type="button" data-md="link" title="Link">Link</button>
                <button type="button" data-md="quote" title="Quotation">“ Quote</button>
                <button type="button" data-md="ul" title="Bulleted list">• List</button>
                <button type="button" data-md="ol" title="Numbered list">1. List</button>
              </div>
              <div class="field"><label for="f-body">Body <span class="hint" id="c-body"></span></label><textarea id="f-body" spellcheck="true"></textarea></div>
              <p class="hint">Formatting buttons insert simple markup. Raw HTML is not allowed; links must start with https://.</p>
            </div>
            <div class="panel">
              <h3>Image</h3>
              <div class="radios" id="img-mode">
                <label><input type="radio" name="imgmode" value="none" checked /> No image (text-led)</label>
                <label id="img-current-opt"><input type="radio" name="imgmode" value="current" /> Keep current image</label>
                <label><input type="radio" name="imgmode" value="upload" /> Upload</label>
                <label><input type="radio" name="imgmode" value="url" /> Image URL / repository path</label>
              </div>
              <div id="img-upload" hidden class="field"><label for="f-file">JPEG, PNG or WebP · at most 3 MB · at least 600 px wide</label><input type="file" id="f-file" accept="image/jpeg,image/png,image/webp" /></div>
              <div id="img-url" hidden class="field"><label for="f-imgurl">https:// URL or /uploads/articles/… path</label><input type="url" id="f-imgurl" maxlength="800" /></div>
              <img class="imgprev" id="img-preview" alt="" hidden />
              <div id="img-meta" hidden>
                <div class="field"><label for="f-alt">Alt text (required)</label><input type="text" id="f-alt" maxlength="300" /></div>
                <div class="field"><label for="f-caption">Caption</label><input type="text" id="f-caption" maxlength="400" /></div>
                <div class="row2">
                  <div class="field"><label for="f-credit">Credit (photographer / agency)</label><input type="text" id="f-credit" maxlength="200" /></div>
                  <div class="field"><label for="f-provider">Provider</label><select id="f-provider"></select></div>
                </div>
                <div class="row2">
                  <div class="field"><label for="f-kind">Kind</label><select id="f-kind"></select></div>
                  <div class="field"><label for="f-license">Licence</label><input type="text" id="f-license" maxlength="120" /></div>
                </div>
                <div class="row2">
                  <div class="field"><label for="f-licenseurl">Licence URL</label><input type="url" id="f-licenseurl" maxlength="500" /></div>
                  <div class="field"><label for="f-sourcepage">Source page</label><input type="url" id="f-sourcepage" maxlength="500" /></div>
                </div>
                <p class="hint">Record only what you know. Never guess a credit or licence.</p>
              </div>
            </div>
            <div class="panel">
              <h3>Classification &amp; sources</h3>
              <div class="field"><label for="tag-in">Tags</label><input type="text" id="tag-in" placeholder="Type a tag and press Enter" maxlength="120" /><div class="chips" id="tag-chips"></div></div>
              <div class="field"><label for="country-in">Countries</label><input type="text" id="country-in" list="countries" placeholder="Type a country and press Enter" /><datalist id="countries"></datalist><div class="chips" id="country-chips"></div></div>
              <div class="field"><span class="label">Regions</span><div class="regions" id="regions"></div></div>
              <div class="field"><label for="f-sources">Source URLs <span class="hint">one per line, https://</span></label><textarea id="f-sources" rows="3" spellcheck="false"></textarea><div class="sources hint" id="source-links"></div></div>
              <div class="field"><label for="f-sourcenote">Source note (internal)</label><input type="text" id="f-sourcenote" maxlength="600" /></div>
            </div>
          </div>
          <div id="preview-pane" hidden>
            <p class="hint">Rendered with the live site's article styles. Nothing here is public.</p>
            <iframe class="preview" id="preview" sandbox="allow-same-origin" title="Article preview"></iframe>
          </div>
        </div>

        <aside class="side">
          <div class="panel">
            <span class="eyebrow" id="ed-kind">New manual story</span>
            <div class="state" id="ed-state">Not saved</div>
            <div class="hint" id="ed-meta"></div>
            <ul class="checks" id="ed-checks"></ul>
            <p id="ed-pr" class="hint"></p>
          </div>
          <div class="panel">
            <h3>Editorial gates</h3>
            <div class="field"><span class="label">Risk</span><div class="radios"><label><input type="radio" name="risk" value="low" /> Low</label><label><input type="radio" name="risk" value="sensitive" /> Sensitive</label></div></div>
            <div class="field"><label for="f-review">Editorial review</label><select id="f-review"><option value="">Not recorded</option><option value="passed">Passed</option><option value="uncertain">Uncertain</option><option value="failed">Failed</option></select></div>
            <div id="verify-block">
              <div class="field"><label for="f-verify">Verification (sensitive stories)</label><select id="f-verify"><option value="">Not recorded</option><option value="cleared">Cleared</option><option value="uncertain">Uncertain</option><option value="failed">Failed</option></select></div>
              <div class="field"><label for="f-reviewer">Reviewed by (the person who verified)</label><input type="text" id="f-reviewer" maxlength="120" /></div>
            </div>
            <p class="hint">The dashboard never marks review or verification as done for you. Record what actually happened.</p>
            <ul class="gates" id="gates"></ul>
            <p class="hint" id="humanled-note" hidden>Opinion, Essay, Ideas and Review are human-led formats: they are published only through this manual path.</p>
          </div>
          <div class="panel">
            <h3>Checks <span class="hint" id="rt"></span></h3>
            <ul class="issues errors" id="errors"></ul>
            <ul class="issues warnings" id="warnings"></ul>
            <div class="actions-grid" id="actions"></div>
            <div class="msg" id="action-msg" role="status"></div>
          </div>
        </aside>
      </div>
    </section>
  </main>
</div>

<dialog id="dlg">
  <form method="dialog" id="dlg-form">
    <h3 id="dlg-title" style="font-weight:400;font-size:22px;margin:0 0 8px"></h3>
    <p id="dlg-text" class="hint"></p>
    <div class="field" id="dlg-field"><label for="dlg-input" id="dlg-label"></label><textarea id="dlg-input" rows="3" maxlength="2000"></textarea></div>
    <div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn" value="cancel">Cancel</button><button class="btn primary" id="dlg-ok" value="ok">Confirm</button></div>
  </form>
</dialog>

<script>
const API = '/api/admin';
const $ = (id) => document.getElementById(id);
const el = (tag, attrs = {}, ...kids) => {
  const n = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (v === undefined || v === null || v === false) continue;
    if (k === 'class') n.className = v; else if (k === 'text') n.textContent = v; else if (k.startsWith('on')) n.addEventListener(k.slice(2), v); else n.setAttribute(k, v === true ? '' : v);
  }
  for (const k of kids.flat()) if (k !== null && k !== undefined && k !== false) n.append(k instanceof Node ? k : document.createTextNode(String(k)));
  return n;
};
const S = { csrf: '', meta: null, articles: [], work: [], view: 'queue', ed: null, checkTimer: 0, pollTimer: 0, lastCheck: null, uploadDataUrl: '', upload: null };

async function api(action, { method = 'GET', body, params = {} } = {}) {
  const q = new URLSearchParams({ action, ...params });
  const res = await fetch(`${API}?${q}`, {
    method, credentials: 'same-origin', cache: 'no-store',
    headers: method === 'POST' ? { 'Content-Type': 'application/json', 'X-Nuvellum-CSRF': S.csrf } : {},
    body: method === 'POST' ? JSON.stringify(body || {}) : undefined
  });
  let data = {};
  try { data = await res.json(); } catch {}
  if (res.status === 401 && action !== 'login') { showLogin('Your session has ended. Log in again.'); throw Object.assign(new Error(data.error || 'Logged out'), { status: 401, data }); }
  if (!res.ok) throw Object.assign(new Error(data.error || `Request failed (${res.status})`), { status: res.status, data });
  return data;
}

function showError(msg) { const n = $('global-error'); n.textContent = msg; n.hidden = !msg; }
function showLogin(msg = '') { $('app').hidden = true; $('login-screen').hidden = false; $('login-msg').textContent = msg; $('login-msg').className = 'msg bad'; $('password').focus(); }

async function boot() {
  try {
    const s = await api('session');
    if (!s.authenticated) return showLogin();
    S.csrf = s.csrf; await enter(s.expires);
  } catch (e) { showLogin(e.status === 503 ? 'The admin is not configured on this deployment.' : 'Could not reach the admin service.'); }
}

$('login-form').addEventListener('submit', async (ev) => {
  ev.preventDefault();
  const msg = $('login-msg'); msg.className = 'msg'; msg.textContent = 'Checking…';
  try {
    const r = await api('login', { method: 'POST', body: { password: $('password').value } });
    $('password').value = ''; S.csrf = r.csrf; await enter(r.expires);
  } catch (e) { msg.className = 'msg bad'; msg.textContent = e.message; }
});

async function enter(expires) {
  $('login-screen').hidden = true; $('app').hidden = false;
  $('session-note').textContent = `Session until ${new Date(expires).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
  S.meta = await api('meta');
  fillSelect($('fs'), S.meta.sections, true); fillSelect($('ft'), S.meta.types, true);
  fillSelect($('f-section'), S.meta.sections); fillSelect($('f-type'), S.meta.types);
  fillSelect($('f-provider'), S.meta.imageProviders); fillSelect($('f-kind'), S.meta.imageKinds);
  $('countries').replaceChildren(...S.meta.countries.map((c) => el('option', { value: c })));
  $('regions').replaceChildren(...S.meta.regions.map((r) => el('label', {}, el('input', { type: 'checkbox', value: r.id, class: 'region' }), ' ', r.label)));
  show('queue');
}

$('logout').addEventListener('click', async () => { try { await api('logout', { method: 'POST' }); } catch {} S.csrf = ''; showLogin('Logged out.'); });

function fillSelect(sel, values, keepFirst = false) {
