function imageMode() { return document.querySelector('input[name=imgmode]:checked')?.value || 'none'; }
function setImageMode(m) { for (const r of document.querySelectorAll('input[name=imgmode]')) r.checked = r.value === m; onImageMode(); }
for (const r of document.querySelectorAll('input[name=imgmode]')) r.addEventListener('change', onImageMode);
function onImageMode() {
  const m = imageMode();
  $('img-upload').hidden = m !== 'upload'; $('img-url').hidden = m !== 'url'; $('img-meta').hidden = m === 'none';
  const p = $('img-preview');
  const src = m === 'current' ? S.ed?.currentImage : m === 'upload' ? S.uploadDataUrl : m === 'url' ? $('f-imgurl').value.trim() : '';
  if (src && (/^https:\/\//.test(src) || src.startsWith('/') || src.startsWith('data:image/'))) { p.src = src; p.hidden = false; } else { p.removeAttribute('src'); p.hidden = true; }
  syncGroups(); scheduleCheck();
}
$('f-imgurl').addEventListener('change', onImageMode);
$('f-file').addEventListener('change', () => {
  const f = $('f-file').files[0];
  if (!f) { S.upload = null; S.uploadDataUrl = ''; return onImageMode(); }
  if (f.size > (S.meta.limits.imageBytes || 3145728)) { S.upload = null; S.uploadDataUrl = ''; $('action-msg').className = 'msg bad'; $('action-msg').textContent = 'That image is larger than 3 MB.'; return onImageMode(); }
  const reader = new FileReader();
  reader.onload = () => { S.uploadDataUrl = String(reader.result); S.upload = { name: f.name, type: f.type, dataBase64: S.uploadDataUrl.split(',')[1] || '' }; onImageMode(); };
  reader.readAsDataURL(f);
});

// Same rule as the newsroom (scripts/lib/newsroom.mjs slugify); the server re-validates every slug.
function slugify(input) {
  const s = String(input).normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return s.length <= 90 ? s : (s.slice(0, 90).replace(/-[^-]*$/, '') || s.slice(0, 90));
}
$('f-title').addEventListener('input', () => { if (!S.ed.slug && !$('f-slug').dataset.touched) $('f-slug').value = slugify($('f-title').value); });
$('f-slug').addEventListener('input', () => { $('f-slug').dataset.touched = '1'; });
for (const id of ['f-title', 'f-dek', 'f-slug', 'f-section', 'f-type', 'f-author', 'f-date', 'f-published', 'f-body', 'f-sources', 'f-sourcenote', 'f-review', 'f-verify', 'f-reviewer', 'f-alt', 'f-caption', 'f-credit', 'f-provider', 'f-kind', 'f-license', 'f-licenseurl', 'f-sourcepage']) {
  $(id).addEventListener('input', () => { updateCounts(); scheduleCheck(); });
}
for (const r of document.querySelectorAll('input[name=risk], .region')) r.addEventListener('change', () => { updateCounts(); scheduleCheck(); });
document.addEventListener('change', (ev) => { if (ev.target.classList?.contains('region')) scheduleCheck(); });
$('f-sources').addEventListener('input', renderSources);

function updateCounts() {
  const L = S.meta?.limits || { title: 180, dek: 360 };
  const t = $('f-title').value.length, d = $('f-dek').value.length;
  $('c-title').textContent = `${t}/${L.title}`; $('c-title').className = `count${t > L.title ? ' over' : ''}`;
  $('c-dek').textContent = `${d}/${L.dek}`; $('c-dek').className = `count${d > L.dek ? ' over' : ''}`;
  const words = ($('f-body').value.match(/[A-Za-z0-9][\w'’-]*/g) || []).length;
  $('c-body').textContent = `${words} words · about ${Math.max(1, Math.round(words / 220))} min read`;
  const sensitive = document.querySelector('input[name=risk]:checked')?.value === 'sensitive';
  $('verify-block').style.opacity = sensitive ? '1' : '.55';
  $('humanled-note').hidden = !['Opinion', 'Essay', 'Ideas', 'Review'].includes($('f-type').value) && $('f-section').value !== 'Opinion';
  syncGroups(); autosize($('f-dek'));
}
function autosize(ta) { if (!ta.offsetParent) return; ta.style.height = 'auto'; ta.style.height = `${ta.scrollHeight + 2}px`; }
function renderSources() {
  const urls = $('f-sources').value.split('\n').map((s) => s.trim()).filter(Boolean);
  $('source-links').replaceChildren(...urls.map((u) => /^https:\/\//.test(u) ? el('div', {}, el('a', { href: u, target: '_blank', rel: 'noopener noreferrer', text: u })) : el('div', { text: `✗ not https: ${u}` })));
}

// Markdown toolbar: wraps or prefixes the current selection.
for (const b of document.querySelectorAll('[data-md]')) b.addEventListener('click', () => {
  const ta = $('f-body'), s = ta.selectionStart, e = ta.selectionEnd, v = ta.value, sel = v.slice(s, e);
  const lineStart = v.lastIndexOf('\n', s - 1) + 1;
  let out, cs, ce;
  const wrap = (a, z, ph) => { const text = sel || ph; out = v.slice(0, s) + a + text + z + v.slice(e); cs = s + a.length; ce = cs + text.length; };
  // Prefix the current line(s). On an empty line only the placeholder is selected, so typing replaces it and keeps the marker.
  const prefix = (fn) => {
    const had = v.slice(lineStart, e);
    const text = (had || 'Text').split('\n').map(fn).join('\n');
    out = v.slice(0, lineStart) + text + v.slice(e);
    ce = lineStart + text.length;
    cs = had ? ce : ce - 'Text'.length;
  };
  switch (b.dataset.md) {
    case 'bold': wrap('**', '**', 'bold text'); break;
    case 'italic': wrap('*', '*', 'italic text'); break;
    case 'link': { const url = prompt('Link address (must start with https://)', 'https://'); if (!url || !/^https:\/\/\S+$/.test(url)) return; wrap('[', `](${url})`, 'link text'); break; }
    case 'h2': prefix((l) => `## ${l.replace(/^#+\s*/, '')}`); break;
    case 'quote': prefix((l) => `> ${l.replace(/^>\s?/, '')}`); break;
    case 'ul': prefix((l) => `- ${l.replace(/^([-*+]|\d+\.)\s+/, '')}`); break;
    case 'ol': { let i = 0; prefix((l) => `${++i}. ${l.replace(/^([-*+]|\d+\.)\s+/, '')}`); break; }
  }
  ta.value = out; ta.focus(); ta.setSelectionRange(cs, ce); updateCounts(); scheduleCheck();
});

function payload(intent) {
  const m = imageMode();
  const pub = $('f-published').value;
  return {
    slug: $('f-slug').value.trim(), intent, branch: S.ed.branch || undefined, expectedSha: S.ed.expectedSha, isNew: !S.ed.branch && !S.ed.mainSha,
    form: {
      title: $('f-title').value, dek: $('f-dek').value, section: $('f-section').value, type: $('f-type').value, author: $('f-author').value,
      date: $('f-date').value, publishedAt: pub ? `${pub.length === 16 ? pub + ':00' : pub}Z` : '', body: $('f-body').value,
      tags: chipsState.tags, countries: chipsState.countries, regions: [...document.querySelectorAll('.region:checked')].map((c) => c.value),
      sourceUrls: $('f-sources').value.split('\n').map((s) => s.trim()).filter(Boolean), sourceNote: $('f-sourcenote').value,
      risk: document.querySelector('input[name=risk]:checked')?.value || '', editorialReview: $('f-review').value, verification: $('f-verify').value, reviewedBy: $('f-reviewer').value
    },
    image: {
      mode: m, url: $('f-imgurl').value.trim(), upload: m === 'upload' ? S.upload : undefined,
      alt: $('f-alt').value, caption: $('f-caption').value, credit: $('f-credit').value, provider: $('f-provider').value, kind: $('f-kind').value,
      license: $('f-license').value, licenseUrl: $('f-licenseurl').value, sourcePage: $('f-sourcepage').value
    }
