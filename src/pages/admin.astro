const S = { csrf: '', meta: null, articles: [], work: [], view: 'queue', ed: null, checkTimer: 0, pollTimer: 0, lastCheck: null, uploadDataUrl: '', upload: null, editMode: 'write', lastPreview: null };

// ---- Day / night ----
// First visit follows the system setting; an explicit choice is remembered in this browser only.
const THEME_KEY = 'nuvellum-admin-theme';
const currentTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
