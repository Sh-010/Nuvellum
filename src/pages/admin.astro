    onclick: () => $(target)?.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' }) },
  el('span', { class: 'n', text: String(n) }), el('span', { class: 'l', text: label }))));
}
function lane(l, items) {
