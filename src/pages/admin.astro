$('f-title').addEventListener('input', () => { if (!S.ed.slug && !$('f-slug').dataset.touched) $('f-slug').value = slugify($('f-title').value); });
$('f-slug').addEventListener('input', () => { $('f-slug').dataset.touched = '1'; });
for (const id of ['f-title', 'f-dek', 'f-slug', 'f-section', 'f-type', 'f-author', 'f-date', 'f-published', 'f-body', 'f-sources', 'f-sourcenote', 'f-review', 'f-verify', 'f-reviewer', 'f-alt', 'f-caption', 'f-credit', 'f-provider', 'f-kind', 'f-license', 'f-licenseurl', 'f-sourcepage']) {
  $(id).addEventListener('input', () => { updateCounts(); scheduleCheck(); });
}
for (const r of document.querySelectorAll('input[name=risk], .region')) r.addEventListener('change', () => { updateCounts(); scheduleCheck(); });
document.addEventListener('change', (ev) => { if (ev.target.classList?.contains('region')) { updateCounts(); scheduleCheck(); } });
$('f-sources').addEventListener('input', renderSources);

function updateCounts() {
  const L = S.meta?.limits || { title: 180, dek: 360 };
  const t = $('f-title').value.length, d = $('f-dek').value.length;
  $('c-title').textContent = `${t}/${L.title}`; $('c-title').className = `count${t > L.title ? ' over' : ''}`;
  $('c-dek').textContent = `${d}/${L.dek}`; $('c-dek').className = `count${d > L.dek ? ' over' : ''}`;
  const words = ($('f-body').value.match(/[A-Za-z0-9][\w'’-]*/g) || []).length;
  $('c-body').textContent = `${words.toLocaleString('en-GB')} words · ${Math.max(1, Math.round(words / 220))} min`;
  $('humanled-note').hidden = !['Opinion', 'Essay', 'Ideas', 'Review'].includes($('f-type').value) && $('f-section').value !== 'Opinion';
  $('cmd-headline').textContent = $('f-title').value.trim() || 'Untitled story';
  syncInspector(); autosize($('f-title')); autosize($('f-dek'));
}
function autosize(ta) { if (!ta.offsetParent) return; ta.style.height = 'auto'; ta.style.height = `${ta.scrollHeight + 2}px`; }
function renderSources() {
  const urls = $('f-sources').value.split('\n').map((s) => s.trim()).filter(Boolean);
  $('source-links').replaceChildren(...urls.map((u) => /^https:\/\//.test(u) ? el('div', {}, el('a', { href: u, target: '_blank', rel: 'noopener noreferrer', text: u })) : el('div', { text: `✗ not https: ${u}` })));
}

// ---- Body formatting (Markdown) ----
// The toolbar and shortcuts never rebuild the whole body: formatMarkdown (src/lib/markdown-format.js) returns
// one edit, only the characters that change are replaced (insertText keeps the browser's own undo history;
// setRangeText is the fallback), and the selection, the textarea's scroll and the page's scroll are put back
// exactly, so formatting leaves the writer looking at the same place.
const bodyEl = $('f-body');
const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent || '');
let bodySel = { start: 0, end: 0, scrollTop: 0 };
const rememberBody = () => { bodySel = { start: bodyEl.selectionStart, end: bodyEl.selectionEnd, scrollTop: bodyEl.scrollTop }; };
for (const ev of ['blur', 'select', 'keyup', 'mouseup', 'input']) bodyEl.addEventListener(ev, rememberBody);
bodyEl.addEventListener('scroll', () => { bodySel.scrollTop = bodyEl.scrollTop; }, { passive: true });
const bodyState = () => (document.activeElement === bodyEl ? { start: bodyEl.selectionStart, end: bodyEl.selectionEnd, scrollTop: bodyEl.scrollTop } : { ...bodySel });

function restoreView(sel, win) {
  const put = () => {
    bodyEl.setSelectionRange(sel.start, sel.end);
    bodyEl.scrollTop = sel.scrollTop;
    if (window.scrollX !== win.x || window.scrollY !== win.y) window.scrollTo(win.x, win.y);
  };
  put(); requestAnimationFrame(put); // browsers may scroll to the caret after the edit lands
  bodySel = { ...sel };
}

function applyBodyEdit(edit, saved, win) {
  const old = bodyEl.value;
  const { from, to, text } = narrowEdit(old, edit);
  bodyEl.focus({ preventScroll: true });
  if (from !== to || text) {
    bodyEl.setSelectionRange(from, to);
    let done = false;
    try { done = document.execCommand(text ? 'insertText' : 'delete', false, text); } catch {}
    if (!done || bodyEl.value !== old.slice(0, from) + text + old.slice(to)) {
      bodyEl.value = old; // execCommand unavailable or partial: fall back to a targeted in-place replacement
      bodyEl.setRangeText(text, from, to, 'end');
      bodyEl.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }
  restoreView({ start: edit.selStart, end: edit.selEnd, scrollTop: saved.scrollTop }, win);
}

async function runFormat(action) {
  const saved = bodyState(), win = { x: window.scrollX, y: window.scrollY };
  const opts = {};
  if (action === 'link' && linkIntent(bodyEl.value, saved.start, saved.end) === 'link') {
    const url = await ask('Add a link', 'Paste the full address. Links must start with https://.', 'Link address', 'https://');
    if (url === false) { bodyEl.focus({ preventScroll: true }); restoreView(saved, win); return; }
    const clean = String(url).replace(/\s+/g, '');
    if (!isSafeLinkUrl(clean)) {
      setMsg('That link was not added: links must start with https://.', 'bad');
      bodyEl.focus({ preventScroll: true }); restoreView(saved, win); return;
    }
    opts.url = clean;
  }
  const edit = formatMarkdown(bodyEl.value, saved.start, saved.end, action, opts);
  if (edit) applyBodyEdit(edit, saved, win);
  else { bodyEl.focus({ preventScroll: true }); restoreView(saved, win); }
}

function runHistory(cmd) {
  const win = { x: window.scrollX, y: window.scrollY };
  bodyEl.focus({ preventScroll: true });
  let ok = false;
  try { ok = document.execCommand(cmd); } catch {}
  if (window.scrollX !== win.x || window.scrollY !== win.y) window.scrollTo(win.x, win.y);
  rememberBody();
  if (!ok) for (const b of document.querySelectorAll('[data-hist]')) { b.disabled = true; b.title = isMac ? 'Use ⌘Z / ⌘⇧Z in the text' : 'Use Ctrl+Z / Ctrl+Y in the text'; }
}

// Buttons keep the caret where it is: pressing one must not move focus or the selection out of the body.
for (const b of document.querySelectorAll('.toolbar [data-md], .toolbar [data-hist]')) {
  const key = b.dataset.hist === 'redo' ? (isMac ? '⌘⇧Z' : 'Ctrl+Y') : b.dataset.hist === 'undo' ? (isMac ? '⌘Z' : 'Ctrl+Z') : b.dataset.key ? `${isMac ? '⌘' : 'Ctrl+'}${b.dataset.key}` : '';
  b.title = key ? `${b.dataset.tip} (${key})` : b.dataset.tip;
  b.addEventListener('mousedown', (ev) => ev.preventDefault());
  b.addEventListener('click', () => (b.dataset.hist ? runHistory(b.dataset.hist) : runFormat(b.dataset.md)));
}

// Editor-local shortcuts, only with the platform's own modifier and only inside the body.
const SHORTCUTS = { b: 'bold', i: 'italic', k: 'link' };
bodyEl.addEventListener('keydown', (ev) => {
  if (ev.altKey || ev.shiftKey || !(isMac ? ev.metaKey && !ev.ctrlKey : ev.ctrlKey && !ev.metaKey)) return;
  const action = SHORTCUTS[String(ev.key).toLowerCase()];
  if (!action) return;
  ev.preventDefault();
  runFormat(action);
});

function payload(intent) {
  const m = imageMode();
  const pub = $('f-published').value;
  return {
    slug: $('f-slug').value.trim(), intent, branch: S.ed.branch || undefined, expectedSha: S.ed.expectedSha, isNew: !S.ed.branch && !S.ed.mainSha,
    form: {
      title: $('f-title').value, dek: $('f-dek').value, section: $('f-section').value, type: $('f-type').value, author: $('f-author').value,
      date: $('f-date').value, publishedAt: pub ? `${pub.length === 16 ? pub + ':00' : pub}Z` : '', body: $('f-body').value,
      tags: chipsState.tags, countries: chipsState.countries, regions: [...document.querySelectorAll('.region:checked')].map((c) => c.value),
      sourceUrls: $('f-sources').value.split('\n').map((s) => s.trim()).filter(Boolean), sourceNote: $('f-sourcenote').value,
      risk: document.querySelector('input[name=risk]:checked')?.value || '', editorialReview: $('f-review').value, verification: $('f-verify').value, reviewedBy: $('f-reviewer').value
    },
    image: {
      mode: m, url: $('f-imgurl').value.trim(), upload: m === 'upload' ? S.upload : undefined,
      alt: $('f-alt').value, caption: $('f-caption').value, credit: $('f-credit').value, provider: $('f-provider').value, kind: $('f-kind').value,
      license: $('f-license').value, licenseUrl: $('f-licenseurl').value, sourcePage: $('f-sourcepage').value
    }
  };
}

function scheduleCheck() { clearTimeout(S.checkTimer); S.checkTimer = setTimeout(() => runCheck(false), 900); }
async function runCheck(immediate) {
  if (!S.ed || S.view !== 'editor') return;
  if (!$('f-slug').value.trim()) return; // nothing to check until the story has a headline/slug
  const intent = S.ed.newsroom || S.ed.mainStatus === 'published' ? 'publish' : 'review';
  try {
    const r = await api('check', { method: 'POST', body: { ...payload(intent), intent } });
    S.lastCheck = r;
    $('rt').textContent = `· ${r.readingTime} read`;
    list('errors', r.errors); list('warnings', r.warnings);
    $('gates').replaceChildren(...r.gates.gates.map((g) => el('li', { class: g.ok ? 'ok' : '' }, g.label, g.value && !g.ok ? el('span', { class: 'hint', text: ` (${g.value})` }) : null)));
    renderPreview(r.preview);
  } catch (e) { if (e.data?.errors) list('errors', e.data.errors); else if (e.status !== 401) list('errors', [e.message]); }
}
// Validation messages: the server's rules are unchanged; describeIssues (src/lib/admin-messages.js) turns
// each one into editorial wording and names the field it is about. Blockers mark that field, write the
// instruction beside it and open any folded group holding it; warnings are listed apart and never block,
// open or mark anything.
function list(id, items) {
  const issues = describeIssues(items);
  $(id).replaceChildren(...issues.map((it) => el('li', { 'data-field': it.field || undefined },
    it.field ? el('button', { type: 'button', class: 'issue-link', text: it.text, title: 'Go to the field', onclick: () => goToField(it) }) : it.text)));
  $(`${id}-h`).hidden = !issues.length;
  if (id === 'errors') S.lastErrors = items || [];
  if (id === 'errors') markIssues(issues);
  updateReadiness();
}
function fieldTarget(field) {
  if (!field) return null;
  if (field === 'risk') return { focus: document.querySelector('input[name=risk]:checked') || document.querySelector('input[name=risk]'), box: document.querySelector('.seg')?.closest('.field') };
  if (field === 'regions') return { focus: document.querySelector('.region'), box: $('regions')?.closest('.field') };
  if (field === 'img-mode') return { focus: document.querySelector('input[name=imgmode]:checked'), box: $('img-mode') };
  const n = $(field);
  if (!n) return null;
  return { focus: n, box: n.id === 'f-body' ? n : n.closest('.field') || n };
}
function markIssues(issues) {
  for (const n of document.querySelectorAll('#view-editor .has-issue')) n.classList.remove('has-issue');
  for (const n of document.querySelectorAll('#view-editor .field-issue')) n.remove();
  for (const it of issues) {
    const t = fieldTarget(it.field);
    if (!t?.box) continue;
    t.box.classList.add('has-issue');
    if (t.box.id !== 'f-body' && t.box.id !== 'img-mode' && !t.box.querySelector('.field-issue')) t.box.append(el('p', { class: 'field-issue', text: it.text }));
    for (let d = t.box.closest('details'); d; d = d.parentElement?.closest('details')) d.open = true;
  }
  syncGroupIssues();
}
function syncGroupIssues() {
  for (const g of document.querySelectorAll('#view-editor details.more-fields')) g.classList.toggle('has-issue', Boolean(g.querySelector('.has-issue')));
}
// Clicking an issue takes the editor to its field: the right Inspector tab (or the writing view) opens,
// folded groups unfold, and only the Inspector scrolls, so the place in the article is kept.
function goToField(it) {
  let t = fieldTarget(it.field);
  if (!t?.box) return;
  const panel = t.box.closest('[data-panel]');
  if (!panel && $('workspace').dataset.mode === 'preview') $('tab-write').click();
  if (panel) openInspector(panel.dataset.panel);
  for (let d = t.box.closest('details'); d; d = d.parentElement?.closest('details')) d.open = true;
  if (t.focus && !t.focus.offsetParent && panel?.dataset.panel === 'media') t = fieldTarget('img-mode');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  requestAnimationFrame(() => {
    if (panel) {
      const c = $('insp-body'), r = t.box.getBoundingClientRect(), cr = c.getBoundingClientRect();
      c.scrollTo({ top: c.scrollTop + r.top - cr.top - 28, behavior: reduce ? 'auto' : 'smooth' });
    } else t.box.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    try { t.focus?.focus({ preventScroll: true }); } catch {}
    t.box.classList.remove('issue-flash'); void t.box.offsetWidth; t.box.classList.add('issue-flash');
  });
}
// A blocker disappears as soon as its field is edited; the next check (moments later) confirms or restores it.
function clearIssueBox(box) {
  if (!box?.classList.contains('has-issue')) return;
  box.classList.remove('has-issue');
  box.querySelector(':scope > .field-issue')?.remove();
  for (const li of [...$('errors').querySelectorAll('li[data-field]')]) if (fieldTarget(li.dataset.field)?.box === box) li.remove();
  S.lastErrors = (S.lastErrors || []).filter((raw) => fieldTarget(describeIssue(raw).field)?.box !== box);
  $('errors-h').hidden = !$('errors').children.length;
  syncGroupIssues(); updateReadiness();
}
function clearIssueFrom(target) {
  if (!target?.closest || target.id === 'tag-in' || target.id === 'country-in') return; // chips count when added, not while typing
  clearIssueBox(target.id === 'f-body' ? target : target.closest('.field.has-issue, #img-mode.has-issue'));
}
$('view-editor').addEventListener('input', (ev) => clearIssueFrom(ev.target));
$('view-editor').addEventListener('change', (ev) => clearIssueFrom(ev.target));

// The preview uses the live site's article stylesheets and markup, in the reader's day or night mode.
// It keeps its own scroll across refreshes, and opens near the part of the article being written.
function renderPreview(html) {
  S.lastPreview = html;
  $('preview-url').textContent = `nuvellum.news/article/${$('f-slug').value.trim() || 'new-story'}`;
  let css = '';
  try { css = JSON.parse($('preview-css').textContent || '""'); } catch {}
  const night = currentTheme() === 'dark';
  const doc = `<!doctype html><html><head><meta charset="utf-8"><base target="_blank"><style>${css.replace(/<\/style/gi, '')}</style></head><body class="reading-page${night ? ' night' : ''}">${html}</body></html>`;
  const fr = $('preview');
  let y = 0;
  try { y = fr.contentWindow?.scrollY || 0; } catch {}
  const sync = S.previewSync; S.previewSync = null;
  fr.onload = () => {
    const img = fr.contentDocument?.querySelector('img[data-pending-upload]');
    if (img && S.uploadDataUrl) img.src = S.uploadDataUrl;
    try {
      if (sync != null) { const h = fr.contentDocument.documentElement.scrollHeight - fr.clientHeight; fr.contentWindow.scrollTo(0, Math.max(0, Math.round(h * sync))); }
      else if (y) fr.contentWindow.scrollTo(0, y);
    } catch {}
  };
  fr.srcdoc = doc;
}

// ---- Actions & status ----
// The command bar carries the publishing path (save, review, prepare, publish); holding, sending back,
// rejecting, discarding and unpublishing sit apart in the More menu.
function renderActions(st = null) {
  const e = S.ed;
  const btn = (label, fn, cls = 'btn', disabled = false, title) => el('button', { class: cls, type: 'button', text: label, onclick: fn, disabled, title });
  const flow = [], review = [], danger = [];
  const open = st?.pr && st.pr.state === 'open';
  if (!e.newsroom) {
    if (!open) flow.push(btn('Save draft', () => save('draft'), 'btn quiet'));
    flow.push(btn(open ? 'Save changes for review' : 'Submit for review', () => save('review'), 'btn quiet'));
    flow.push(btn(e.mainStatus === 'published' ? 'Prepare update for publication' : 'Prepare publication', () => save('publish'), 'btn primary'));
  } else {
    flow.push(btn('Save edits (keep in review)', () => save('review'), 'btn quiet'));
    flow.push(btn('Approve & prepare publication', () => save('publish'), 'btn primary'));
  }
  if (st?.canMerge) flow.push(btn(st.state === 'Ready to unpublish' ? 'Unpublish now' : 'Publish now', () => mergeNow(st), 'btn go'));
  else if (open) flow.push(btn('Publish now', null, 'btn go', true, 'Waiting for the editorial gates and every required check'));
  if (open) {
    const held = (st.pr.labels || []).some((l) => ['hold', 'needs-human'].includes(l));
    review.push(held ? btn('Release hold', () => reviewAction('release'), 'btn quiet') : btn('Hold', () => reviewAction('hold'), 'btn quiet'));
    review.push(btn('Send back for changes…', () => reviewAction('sendback'), 'btn quiet'));
    danger.push(btn('Reject…', () => reviewAction('reject'), 'btn danger'));
  }
  if (!e.newsroom && e.branch && !open && !st?.pr?.merged) danger.push(btn('Discard draft…', discardDraft, 'btn danger'));
  if (!e.branch && e.mainStatus === 'published') danger.push(btn('Unpublish…', unpublish, 'btn danger'));
  $('actions').replaceChildren(...flow);
  const extra = [...review, ...(danger.length ? [el('div', { class: 'more-sep' }), el('span', { class: 'more-label', text: 'Removal and rejection' }), ...danger] : [])];
  $('more-actions').replaceChildren(...extra);
  $('more').hidden = !extra.length;
  if (!extra.length) $('more').open = false;
}

// Short confirmations appear as a toast; the text stays readable in #action-msg.
let msgTimer = 0;
function setMsg(text, kind = '') {
  const n = $('action-msg');
  n.textContent = text;
  n.className = `toast${text ? ' show' : ''}${kind ? ` ${kind}` : ''}`;
  clearTimeout(msgTimer);
  if (text) msgTimer = setTimeout(() => n.classList.remove('show'), kind === 'bad' ? 9000 : 5000);
}

async function save(intent) {
  setMsg('Saving…');
  try {
    const r = await api('save', { method: 'POST', body: payload(intent) });
    Object.assign(S.ed, { slug: r.slug, branch: r.branch, expectedSha: r.articleSha, pr: r.pr || S.ed.pr });
    $('f-slug').value = r.slug; $('f-slug').readOnly = true;
    if (imageMode() === 'upload' && S.upload) { S.ed.currentImage = null; }
    S.dirty = false; S.savedAt = Date.now(); renderSaveState();
    setMsg(intent === 'draft' ? 'Draft saved. Nothing is public.' : r.pr ? `Saved to pull request #${r.pr.number}. Required checks are running.` : 'Saved.', 'ok');
    $('editor-notice').hidden = false; $('editor-notice').textContent = `Working copy saved${r.pr ? ` in pull request #${r.pr.number}` : ''}. The live site is unchanged until you publish.`;
    pollStatus();
  } catch (e) {
    setMsg(e.message, 'bad');
    if (e.data?.errors) { list('errors', e.data.errors); if (describeIssues(e.data.errors).some((i) => !i.field || tabOf(i.field))) openInspector('checks'); }
  }
}

async function pollStatus() {
  clearInterval(S.pollTimer);
  const tick = async () => {
    if (!S.ed?.branch || S.view !== 'editor') return clearInterval(S.pollTimer);
    try {
      const st = await api('status', { params: { branch: S.ed.branch } });
      S.ed.status = st; S.ed.pr = st.pr;
      setState(st.state);
      $('ed-meta').textContent = `/${st.slug} · file status: ${st.fileStatus || '—'}${st.mainStatus ? ` · on site: ${st.mainStatus}` : ' · not yet on site'}`;
      $('ed-checks').replaceChildren(...(st.checks || []).map((c) => el('li', {}, c.name, el('span', { class: `badge ${c.conclusion === 'success' ? 'ok' : c.status === 'completed' ? 'bad' : 'wait'}`, text: c.status === 'completed' ? c.conclusion : c.status }))));
      $('ed-pr').replaceChildren(...(st.pr ? [el('a', { href: st.pr.url, target: '_blank', rel: 'noopener', text: `GitHub pull request #${st.pr.number}` }), st.pr.labels?.length ? ` · labels: ${st.pr.labels.join(', ')}` : ''] : []));
      const done = (st.checks || []).filter((c) => c.status === 'completed').length;
      $('gs-tech').textContent = st.pr ? `PR #${st.pr.number}${st.checks?.length ? ` · checks ${done}/${st.checks.length}` : ''}` : 'No pull request yet';
      renderActions(st);
      if (!/running|created/i.test(st.state)) clearInterval(S.pollTimer);
    } catch (e) { clearInterval(S.pollTimer); }
  };
  await tick();
  S.pollTimer = setInterval(tick, 15000);
}

async function mergeNow(st) {
  const verb = st.state === 'Ready to unpublish' ? 'unpublish' : 'publish';
  if (!(await ask(`${verb === 'publish' ? 'Publish' : 'Unpublish'} this story?`, `This merges pull request #${st.pr.number} into main. Vercel then deploys the site. All required checks passed on commit ${st.headSha.slice(0, 7)}.`))) return;
  setMsg('Merging…');
  try {
    const r = await api('merge', { method: 'POST', body: { number: st.pr.number, sha: st.headSha } });
    setMsg(`${r.state}. ${r.note}`, 'ok');
    setState(r.state); clearInterval(S.pollTimer); S.ed.branch = null; S.ed.mainStatus = r.state === 'Published' ? 'published' : 'draft'; renderActions();
  } catch (e) { setMsg(e.message, 'bad'); if (e.data?.errors) list('errors', e.data.errors); pollStatus(); }
}

async function reviewAction(action) {
  $('more').open = false;
  const st = S.ed.status;
  const needsNote = action === 'sendback' || action === 'reject';
  const titles = { hold: 'Hold this story?', release: 'Release the hold?', sendback: 'Send back for changes', reject: 'Reject this story?' };
  const texts = { hold: 'It will not publish (manually or automatically) until released.', release: 'It becomes publishable again once gates and checks pass.', sendback: 'The note is recorded on the pull request and the story is held until someone edits it.', reject: 'The pull request is closed with your note. The story will not be published.' };
  const note = await ask(titles[action], texts[action], needsNote ? 'Note (required)' : 'Note (optional)');
  if (note === false) return;
  setMsg('Recording…');
  try { await api('review', { method: 'POST', body: { number: st.pr.number, action, note: typeof note === 'string' ? note : '' } }); setMsg('Recorded.', 'ok'); pollStatus(); }
  catch (e) { setMsg(e.message, 'bad'); }
}

async function discardDraft() {
  $('more').open = false;
  if (!(await ask('Discard this draft?', 'The working branch and any open pull request are closed. The live site is not affected.'))) return;
  try { await api('discard', { method: 'POST', body: { branch: S.ed.branch } }); setMsg('Draft discarded.', 'ok'); S.ed.branch = null; S.ed.expectedSha = S.ed.mainSha; renderActions(); }
  catch (e) { setMsg(e.message, 'bad'); }
}

async function unpublish() {
  $('more').open = false;
  const typed = await ask('Unpublish this story?', `The story is taken off the site but kept in the repository with its history (status becomes "draft"). Type the slug to confirm: ${S.ed.slug}`, 'Slug');
  if (typed === false) return;
  if (typed !== S.ed.slug) { setMsg('The slug did not match; nothing was changed.', 'bad'); return; }
  try {
    const r = await api('save', { method: 'POST', body: { intent: 'unpublish', slug: S.ed.slug, confirm: typed, expectedSha: S.ed.mainSha } });
    Object.assign(S.ed, { branch: r.branch, pr: r.pr });
    setMsg(`Unpublish prepared in pull request #${r.pr.number}. Publish it once checks pass.`, 'ok');
    pollStatus();
  } catch (e) { setMsg(e.message, 'bad'); }
}

// Confirmation dialog: resolves true/false, or the typed text when a field is shown.
function ask(title, text, fieldLabel = '', initial = '') {
  return new Promise((resolve) => {
    const d = $('dlg');
    $('dlg-title').textContent = title; $('dlg-text').textContent = text; $('dlg-field').hidden = !fieldLabel; $('dlg-label').textContent = fieldLabel; $('dlg-input').value = initial;
    d.onclose = () => resolve(d.returnValue === 'ok' ? (fieldLabel ? $('dlg-input').value.trim() : true) : false);
    d.showModal();
  });
}

boot();
</script>
</body>
</html>
