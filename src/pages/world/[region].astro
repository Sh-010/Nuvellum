---
import InteriorShell from '../../components/InteriorShell.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getArticles } from '../../lib/articles';
import { REGIONS, regionBySlug, regionsForArticle } from '../../lib/geography.js';
import { COUNTRIES, countrySlug } from '../../lib/countries.js';

export async function getStaticPaths() {
  return REGIONS.map(region => ({ params: { region: region.slug } }));
}

const slug = Astro.params.region!;
const region = regionBySlug(slug);
if (!region) throw new Error(`Unknown World Desk region: ${slug}`);
const articles = (await getArticles()).filter(article => regionsForArticle(article).includes(slug));
const countries = COUNTRIES.filter(country => country.region === slug).sort((a,b) => a.name.localeCompare(b.name));
const lead = articles[0];
const secondary = articles.slice(1,3);
const rest = articles.slice(3);
---
<InteriorShell
  title={`${region.label} — World Desk — Nuvellum`}
  description={`Latest Nuvellum reporting connected to ${region.label}.`}
  active="world"
>
  <div class="int-wrap int-page">
    <header class="int-page-head" data-reveal>
      <div>
        <div class="int-page-kicker">World Desk</div>
        <h1 class="int-page-title">{region.label}</h1>
        <p class="int-page-dek">Nuvellum reporting filed to this regional desk, with direct country coverage connected to the same World Explorer geography model.</p>
      </div>
      <div class="int-page-note">{articles.length} published {articles.length === 1 ? 'story' : 'stories'} · {countries.length} countries and territories in this desk.</div>
    </header>

    {lead ? (
      <>
        <section class="int-feature-grid" aria-label={`${region.label} lead stories`}>
          <StoryCard article={lead} variant="lead" />
          <div class="int-feature-side">{secondary.map(article => <StoryCard article={article} variant="compact" />)}</div>
        </section>
        {rest.length > 0 && (
          <section>
            <div class="int-section-label"><h2>Across the desk</h2><a href="/world-explorer">Open World Explorer →</a></div>
            <div class="int-feed">{rest.map((article,index) => <StoryCard article={article} variant="row" index={index + 1} />)}</div>
          </section>
        )}
      </>
    ) : (
      <div class="int-empty">No published Nuvellum stories are currently classified in this regional desk.</div>
    )}

    <section>
      <div class="int-section-label"><h2>Countries & territories</h2><a href="/world-explorer">Explore on the globe →</a></div>
      <nav class="int-country-index" aria-label={`${region.label} countries and territories`}>
        {countries.map(country => <a href={`/country/${countrySlug(country.name)}`}>{country.name}</a>)}
      </nav>
    </section>
  </div>
</InteriorShell>
