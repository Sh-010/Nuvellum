---
import InteriorShell from '../../components/InteriorShell.astro';
import Story from '../../components/Story.astro';
import Locator from '../../components/Locator.astro';
import Gazetteer from '../../components/Gazetteer.astro';
import ExplorerBand from '../../components/ExplorerBand.astro';
import { getArticles } from '../../lib/articles';
import type { Article } from '../../lib/articles';
import { COUNTRIES, countryBySlug, countrySlug, storiesForCountry } from '../../lib/countries.js';
import { regionBySlug, regionsForArticle } from '../../lib/geography.js';
import { plural } from '../../lib/interior';

export async function getStaticPaths() {
  return COUNTRIES.map(country => ({ params: { country: countrySlug(country.name) } }));
}

const slug = Astro.params.country!;
const country = countryBySlug(slug);
if (!country) throw new Error(`Unknown country: ${slug}`);
const region = regionBySlug(country.region)!;
const all = await getArticles();
const direct: Article[] = storiesForCountry(all, country.name);
const regional = all
  .filter(article => regionsForArticle(article).includes(country.region) && !direct.some(item => item.slug === article.slug))
  .slice(0, 6);
const bureau = COUNTRIES.filter(item => item.region === country.region);
const counts = new Map(bureau.map(c => [c.name, storiesForCountry(all, c.name).length]));
const lead = direct[0];
const secondary = direct.slice(1, 3);
const rest = direct.slice(3);

const STATUS: Record<string, string> = {
  'un-member': 'UN member state',
  'un-observer': 'UN General Assembly observer state',
  'partially-recognized': 'State recognised by some UN members',
  'de-facto': 'Self-declared state without UN-member recognition',
  'disputed-territory': 'Territory whose sovereignty is contested',
  dependency: 'Territory'
};
const status = country.status === 'dependency' && country.parent ? `Territory of ${country.parent}` : STATUS[country.status] || 'Territory';
const titleSize = country.name.length > 26 ? 'font-size:clamp(46px,5.6vw,88px)' : country.name.length > 16 ? 'font-size:clamp(52px,7vw,112px)' : 'font-size:clamp(64px,10.5vw,168px)';
---
<InteriorShell
  title={`${country.name} — Country desk — Nuvellum`}
  description={`Nuvellum reporting from ${country.name}, with regional context from the ${region.label} desk.`}
  active="world"
  folio={[{ label: 'World', href: '/section/world' }, { label: region.label, href: `/world/${region.slug}` }, { label: country.name }]}
  folioNote="Country desk"
>
  <div class="shell page">
    <header class="desk-head">
      <div>
        <div class="desk-kicker" data-reveal><span>✦ Country desk</span><span class="sep">/</span><a href={`/world/${region.slug}`}>{region.label}</a></div>
        <h1 class="desk-title" data-reveal style={`--d:80ms;${titleSize}`}>{country.name}</h1>
        <p class="desk-dek" data-reveal style="--d:160ms">{status} on Nuvellum’s {region.label} desk. {direct.length ? `${plural(direct.length, 'report')} name ${country.name} directly.` : `No report has named ${country.name} directly yet.`}</p>
      </div>
      <aside class="desk-aside" data-reveal style="--d:220ms">
        <Locator region={country.region} country={country} label={`${country.name} located within ${region.label}`} caption={`${country.name} · ${region.label}`} />
        <dl class="facts">
          <div><dt>Direct reporting</dt><dd>{direct.length}</dd></div>
          <div><dt>Regional desk</dt><dd><a href={`/world/${region.slug}`}>{region.label}</a></dd></div>
          <div><dt>Status</dt><dd style="font-size:14px">{country.status === 'un-member' ? 'UN member' : status}</dd></div>
        </dl>
      </aside>
    </header>

    <div class="desk-body">
      {lead && secondary.length >= 2 && (
        <section class="pkg-desk" aria-label={`Reporting from ${country.name}`}>
          <Story article={lead} variant="lead" eager />
          <div class="side">{secondary.map((a, i) => <Story article={a} variant="second" d={120 + i * 90} />)}</div>
        </section>
      )}
      {lead && secondary.length < 2 && (
        <Story article={lead} variant="wide" eager>
          {secondary.map(a => <Story article={a} variant="second" d={200} />)}
          <div class="side-note" data-reveal style="--d:260ms">
            <span class="eyebrow">On this desk</span>
            <p>Reporting is filed here when a story names {country.name}. Wider coverage from {region.label} follows below.</p>
          </div>
        </Story>
      )}
      {!lead && (
        <div class="quiet-note" data-reveal>
          <span class="mark" aria-hidden="true">✦</span>
          <div>
            <h2>No reporting from {country.name} has been filed yet.</h2>
            <p>When a Nuvellum story names {country.name}, it will lead this desk. Meanwhile, the <a href={`/world/${region.slug}`}>{region.label} bureau</a> carries the region’s reporting{regional.length ? ', with the latest below' : ''}.</p>
          </div>
        </div>
      )}

      {rest.length > 0 && (
        <section class="block" aria-labelledby="more-direct">
          <div class="section-title" data-reveal><h2 id="more-direct">More from {country.name}</h2><span class="rule"></span><span class="note">{plural(rest.length, 'further report')}</span></div>
          <div class="rows">{rest.map((a, i) => <Story article={a} variant="row" d={Math.min(i, 5) * 60} />)}</div>
        </section>
      )}

      {regional.length > 0 && (
        <section class="block" aria-labelledby="regional">
          <div class="section-title" data-reveal><h2 id="regional">Regional context</h2><span class="rule"></span><a href={`/world/${region.slug}`}>{region.label} desk →</a></div>
          <div class="rows">{regional.map((a, i) => <Story article={a} variant="row" d={Math.min(i, 5) * 60} />)}</div>
        </section>
      )}

      <section class="block" aria-labelledby="bureau">
        <div class="section-title" data-reveal><h2 id="bureau">Also on the {region.label} desk</h2><span class="rule"></span><span class="note">✦ marks direct reporting</span></div>
        <Gazetteer countries={bureau} counts={counts} current={country.name} />
      </section>
    </div>
  </div>

  <ExplorerBand
    region={country.region}
    country={country}
    title={`Find ${country.name} on the globe`}
    text={`The World Explorer places ${country.name} among the ${bureau.length} countries and territories of the ${region.label} desk. Turn the globe to move between neighbouring desks.`}
  />
</InteriorShell>
