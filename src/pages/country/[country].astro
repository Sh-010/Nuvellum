---
import InteriorShell from '../../components/InteriorShell.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getArticles } from '../../lib/articles';
import { COUNTRIES, countryBySlug, countrySlug, storiesForCountry } from '../../lib/countries.js';
import { regionBySlug, regionsForArticle } from '../../lib/geography.js';

export async function getStaticPaths() {
  return COUNTRIES.map(country => ({ params: { country: countrySlug(country.name) } }));
}

const slug = Astro.params.country!;
const country = countryBySlug(slug);
if (!country) throw new Error(`Unknown country: ${slug}`);
const region = regionBySlug(country.region);
const articles = await getArticles();
const direct = storiesForCountry(articles, country.name);
const regional = articles
  .filter(article => regionsForArticle(article).includes(country.region) && !direct.some(item => item.slug === article.slug))
  .slice(0,8);
const neighbors = COUNTRIES.filter(item => item.region === country.region && item.name !== country.name).sort((a,b)=>a.name.localeCompare(b.name));
---
<InteriorShell
  title={`${country.name} — World Desk — Nuvellum`}
  description={`Nuvellum reporting connected to ${country.name} and ${region?.label || 'its region'}.`}
  active="world"
>
  <div class="int-wrap int-page">
    <header class="int-page-head" data-reveal>
      <div>
        <div class="int-page-kicker">{region?.label || 'World Desk'}</div>
        <h1 class="int-page-title">{country.name}</h1>
        <p class="int-page-dek">{direct.length
          ? `${direct.length} direct Nuvellum ${direct.length === 1 ? 'story is' : 'stories are'} currently connected to this country.`
          : 'No direct Nuvellum story is tagged to this country yet; regional reporting appears below.'}</p>
      </div>
      <div class="int-page-note"><a class="int-action" href="/world-explorer">Locate in World Explorer →</a><br/><a class="int-action" href={`/world/${country.region}`}>Open regional desk →</a></div>
    </header>

    {direct.length > 0 && (
      <section>
        <div class="int-section-label"><h2>Direct coverage</h2><span>{direct.length}</span></div>
        <section class="int-feature-grid">
          <StoryCard article={direct[0]} variant="lead" />
          <div class="int-feature-side">{direct.slice(1,3).map(article => <StoryCard article={article} variant="compact" />)}</div>
        </section>
        {direct.length > 3 && <div class="int-feed" style="margin-top:32px">{direct.slice(3).map((article,index)=><StoryCard article={article} variant="row" index={index+1}/>)}</div>}
      </section>
    )}

    <section>
      <div class="int-section-label"><h2>{direct.length ? 'Regional context' : 'Regional coverage'}</h2><a href={`/world/${country.region}`}>{region?.label || 'World Desk'} →</a></div>
      {regional.length ? (
        <div class="int-feed">{regional.map((article,index)=><StoryCard article={article} variant="row" index={index+1}/>)}</div>
      ) : <div class="int-empty">No additional regional stories are available yet.</div>}
    </section>

    <section>
      <div class="int-section-label"><h2>Elsewhere in the region</h2><span>World Explorer index</span></div>
      <nav class="int-country-index" aria-label="Other countries and territories in this region">
        {neighbors.map(item => <a href={`/country/${countrySlug(item.name)}`}>{item.name}</a>)}
      </nav>
    </section>
  </div>
</InteriorShell>
