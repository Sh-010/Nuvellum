---
import SiteHead from '../../components/SiteHead.astro';
import '../../styles/article.css';
import { getArticles, slugify } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = article;
const allArticles = await getArticles();
const related = [
  ...allArticles.filter((a) => a.slug !== article.slug && a.section === article.section),
  ...allArticles.filter((a) => a.slug !== article.slug && a.section !== article.section)
].slice(0,3);
const headings = article.getHeadings ? await article.getHeadings() : [];
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const site = Astro.site ?? new URL('https://nuvellum.vercel.app');
const articleUrl = new URL(`/article/${article.slug}`, site).toString();
const imageUrl = new URL(article.image, site).toString();
const publishedTime = `${article.date}T00:00:00Z`;
const modifiedDate = article.updated || article.date;
const modifiedTime = `${modifiedDate}T00:00:00Z`;
const authorIsDesk = /desk|team|staff/i.test(article.author);
const articleSchema = {
  '@context':'https://schema.org',
  '@type': article.type === 'Opinion' || article.type === 'Essay' || article.type === 'Ideas' ? 'Article' : 'NewsArticle',
  headline: article.title,
  description: article.dek,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    '@type': authorIsDesk ? 'Organization' : 'Person',
    name: article.author,
    url: new URL(`/author/${slugify(article.author)}`, site).toString()
  },
  publisher: {'@type':'Organization','name':'Nuvellum','url':site.toString()},
  mainEntityOfPage: articleUrl,
  image: [imageUrl]
};
---
<!doctype html><html lang="en"><head>
<SiteHead title={`${article.title} — Nuvellum`} description={article.dek} image={article.image} type="article" publishedTime={publishedTime} modifiedTime={modifiedTime} author={article.author} />
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
</head><body>
<div class="article-curtain" id="articleCurtain"></div><div class="progress" id="progress"></div>
<header class="site-header"><div class="head wrap"><a class="back" href="/">← Back to Nuvellum</a><a class="brand article-logo" id="articleLogo" href="/"><span>N</span><span>U</span><span>V</span><span>E</span><span>L</span><span>L</span><span>U</span><span>M</span></a><div class="head-actions"><button class="btn" id="fontBtn">Text +</button><button class="btn" id="saveBtn">Save</button><button class="btn" id="shareBtn">Share</button><button class="btn" id="themeBtn">Night</button></div></div></header>
<main>
<header class="article-head" data-title={article.title} data-kicker={`${article.section} · ${article.type}`}><div class="kicker">{article.section.toUpperCase()} · {article.type.toUpperCase()}</div><h1>{article.title}</h1><div class="dek">{article.dek}</div><div class="byline"><strong><a href={`/author/${slugify(article.author)}`}>{article.author}</a></strong><span>{new Date(article.date+'T00:00:00Z').toLocaleDateString('en-GB',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})} · {article.readingTime} read</span></div></header>
<figure class="hero"><img src={article.image} alt={article.imageAlt}/><figcaption class="caption">{article.origin === 'automation' && article.image.startsWith('/generated/ai/') ? 'NUVELLUM · AI-generated editorial illustration' : article.origin === 'automation' ? 'NUVELLUM · Original editorial illustration' : 'NUVELLUM · Illustrative launch image'}</figcaption></figure>
<div class="article-layout"><aside class="rail"><div class="rail-title">Reading tools</div><button class="btn" id="smaller">A−</button><button class="btn" id="larger">A+</button><button class="btn" id="copyBtn">Copy link</button></aside>
<article class="body" id="articleBody"><Content /><div class="end"><div class="kicker">NUVELLUM · BEYOND THE HEADLINE</div><p>News, analysis, opinion and review are labeled separately across Nuvellum.</p></div></article>
<aside class="toc"><h3>In this story</h3>{tocHeadings.length ? tocHeadings.map((heading)=><a class:list={[heading.depth===3 && 'toc-sub']} href={`#${heading.slug}`}>{heading.text}</a>) : <span>No section headings.</span>}</aside></div>
<section class="more"><div class="wrap"><h2>Continue reading</h2><div class="moregrid">{related.map((r)=><a href={`/article/${r.slug}`}><article tabindex="0" data-related={r.title}><div class="kicker">{r.section.toUpperCase()}</div><h3>{r.title}</h3></article></a>)}</div></div></section>
</main><div class="article-progress-label" id="progressLabel">0% read</div><div class="article-tools-pop" id="articlePop" aria-live="polite"></div><div class="share-toast" id="toast">Link copied.</div>
<script is:inline src="/js/article.js"></script>
</body></html>
