---
// Article reading page: the interior publication system in its quietest register. Shares the
// v6 masthead, folio, footer and night mode with the section and desk pages; drops the ticker
// and adds reading chrome (progress, sticky reading strip, text size, save, share, TOC).
import InteriorShell from '../../components/InteriorShell.astro';
import Story from '../../components/Story.astro';
import '../../styles/article.css';
import { getArticles, slugify } from '../../lib/articles';
import { initials, longDate } from '../../lib/interior';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = article;
const allArticles = await getArticles();
const related = [
  ...allArticles.filter((a) => a.slug !== article.slug && a.section === article.section),
  ...allArticles.filter((a) => a.slug !== article.slug && a.section !== article.section)
].slice(0,3);
const headings = article.getHeadings ? await article.getHeadings() : [];
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const site = Astro.site ?? new URL('https://nuvellum.vercel.app');
const articleUrl = new URL(`/article/${article.slug}`, site).toString();
const imageUrl = new URL(article.image, site).toString();
// publishedAt (automated stories) is the real publication time; older stories only have a date.
const publishedTime = article.publishedAt && article.publishedAt.startsWith(article.date) ? article.publishedAt : `${article.date}T00:00:00Z`;
const modifiedDate = article.updated || article.date;
const modifiedTime = article.updated ? `${modifiedDate}T00:00:00Z` : publishedTime;
// sourceUrls / sourceNote stay in the content metadata for the newsroom, verification and duplicate
// checks; they are not published on the page. Attribution belongs in the story text where the reporting needs it.
const authorIsDesk = /desk|team|staff/i.test(article.author);
const articleSchema = {
  '@context':'https://schema.org',
  '@type': article.type === 'Opinion' || article.type === 'Essay' || article.type === 'Ideas' ? 'Article' : 'NewsArticle',
  headline: article.title,
  description: article.dek,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    '@type': authorIsDesk ? 'Organization' : 'Person',
    name: article.author,
    url: new URL(`/author/${slugify(article.author)}`, site).toString()
  },
  publisher: {'@type':'Organization','name':'Nuvellum','url':site.toString()},
  mainEntityOfPage: articleUrl,
  image: [imageUrl]
};

const sectionKey = slugify(article.section);
const SCREEN = ['anime', 'film-tv', 'gaming'];
const active = SCREEN.includes(sectionKey) ? 'entertainment' : sectionKey;
const sectionHref = `/section/${sectionKey}`;
const authorHref = `/author/${slugify(article.author)}`;
const displayDate = longDate(article);
const updatedDate = article.updated ? new Date(`${article.updated}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
const caption = article.imageCaption
  || (article.imageProvider === 'wikimedia' ? 'Editorial file photo'
  : article.origin === 'automation' && article.image.startsWith('/generated/ai/') ? 'AI-generated editorial illustration'
  : article.origin === 'automation' ? 'Original editorial illustration'
  : 'Illustrative launch image');
const visualCredit = article.imageProvider === 'wikimedia' && article.imageCredit && article.imageLicense && article.imageLicenseUrl && article.imageSourcePage
  ? { credit: article.imageCredit, license: article.imageLicense, licenseUrl: article.imageLicenseUrl, sourcePage: article.imageSourcePage }
  : null;
const [leadRelated, ...moreRelated] = related;
const tools = [
  { action: 'smaller', label: 'A−', aria: 'Decrease text size' },
  { action: 'larger', label: 'A+', aria: 'Increase text size' },
  { action: 'save', label: 'Save', aria: 'Save this story' },
  { action: 'share', label: 'Share', aria: 'Share this story' }
];
---
<InteriorShell
  title={`${article.title} — Nuvellum`}
  description={article.dek}
  image={article.image}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={article.author}
  active={active}
  folio={[{ label: article.section, href: sectionHref }, { label: article.type || 'News' }]}
  folioNote={`Filed ${displayDate}`}
  ticker={false}
  bodyClass="reading-page"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>

  <div class="read-progress" aria-hidden="true"><span id="readProgress"></span></div>
  <div class="reading-strip" id="readingStrip" aria-hidden="true">
    <div class="shell strip-in">
      <a class="strip-mark" href="/" tabindex="-1" aria-label="Nuvellum home">N<span>✦</span></a>
      <span class="strip-section">{article.section}</span>
      <span class="strip-title">{article.title}</span>
      <span class="strip-pct" id="readPct">0%</span>
      <div class="tools compact">{tools.map(t => <button type="button" class="tool" data-action={t.action} aria-label={t.aria} tabindex="-1">{t.label}</button>)}</div>
    </div>
  </div>

  <article class="story-page" aria-labelledby="story-title">
    <header class="rgrid opening">
      <div class="opening-main">
        <div class="opening-kicker" data-reveal><a class="eyebrow" href={sectionHref}>✦ {article.section}</a><span class="sep" aria-hidden="true">/</span><span class="type">{article.type || 'News'}</span></div>
        <h1 id="story-title" data-reveal style="--d:80ms">{article.title}</h1>
        <p class="standfirst" data-reveal style="--d:160ms">{article.dek}</p>
        <div class="byline-row" id="bylineRow" data-reveal style="--d:240ms">
          <a class="by-mark" href={authorHref} aria-hidden="true" tabindex="-1">{initials(article.author)}</a>
          <div class="by-text">
            <span class="by-name">By <a href={authorHref}>{article.author}</a></span>
            <span class="by-meta"><time datetime={publishedTime}>{displayDate}</time>{updatedDate && <><span class="dot">●</span>Updated {updatedDate}</>}<span class="dot">●</span>{article.readingTime} read</span>
          </div>
          <div class="tools" role="toolbar" aria-label="Article tools">{tools.map(t => <button type="button" class="tool" data-action={t.action} aria-label={t.aria}>{t.label}</button>)}</div>
        </div>
      </div>
    </header>

    <figure class="rgrid lead-figure" data-reveal style="--d:300ms">
      <div class="lead-media"><img src={article.image} alt={article.imageAlt} fetchpriority="high" /></div>
      <figcaption>
        <span class="eyebrow">✦ Nuvellum</span>
        <span class="visual-caption">{caption}</span>
        {visualCredit && (
          <span class="visual-credit">
            Photo: <a href={visualCredit.sourcePage} target="_blank" rel="noopener noreferrer">{visualCredit.credit}</a>
            <span aria-hidden="true"> · </span>
            <a href={visualCredit.licenseUrl} target="_blank" rel="noopener noreferrer">{visualCredit.license}</a>
          </span>
        )}
      </figcaption>
    </figure>

    <div class="rgrid reading">
      <aside class="reading-rail">
        {tocHeadings.length > 0 && (
          <details class="toc" id="toc" open>
            <summary><span class="eyebrow">In this story</span><span class="toc-count">{tocHeadings.length} {tocHeadings.length === 1 ? 'section' : 'sections'}</span></summary>
            <nav aria-label="In this story">
              <ol>{tocHeadings.map((h, i) => <li class:list={[h.depth === 3 && 'toc-sub']}><a href={`#${h.slug}`}><span class="toc-num">{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>)}</ol>
            </nav>
          </details>
        )}
      </aside>

      <div class="reading-col">
        <div class="body" id="articleBody"><Content /></div>

        <footer class="story-end">
          <div class="end-mark" aria-hidden="true"><span>✦</span></div>
          <div class="eyebrow">Nuvellum · Beyond the headline</div>
          <p>News, analysis, opinion and review are labeled separately across Nuvellum.</p>
          <div class="end-row">
            <span>Filed under <a href={sectionHref}>{article.section}</a> · {article.type || 'News'}</span>
            <span>By <a href={authorHref}>{article.author}</a></span>
            <a href="/corrections">Report an error →</a>
          </div>
          <div class="tools" role="toolbar" aria-label="Article tools">{tools.filter(t => t.action === 'save' || t.action === 'share').map(t => <button type="button" class="tool" data-action={t.action} aria-label={t.aria}>{t.label}</button>)}</div>
        </footer>
      </div>

      <aside class="reading-notes" aria-label="Story file">
        <div class="story-file">
          <span class="eyebrow">Story file</span>
          <dl class="facts">
            <div><dt>Section</dt><dd><a href={sectionHref}>{article.section}</a></dd></div>
            <div><dt>Format</dt><dd>{article.type || 'News'}</dd></div>
            <div><dt>Published</dt><dd>{displayDate}</dd></div>
            <div><dt>Reading</dt><dd>{article.readingTime}</dd></div>
          </dl>
        </div>
      </aside>
    </div>
  </article>

  {leadRelated && (
    <section class="shell continue" aria-labelledby="continue-title">
      <div class="section-title" data-reveal><h2 id="continue-title">Continue reading</h2><span class="rule"></span><a href="/latest">The full edition →</a></div>
      <div class="pkg-desk">
        <Story article={leadRelated} variant="lead" />
        <div class="side">{moreRelated.map((a, i) => <Story article={a} variant="second" d={120 + i * 90} />)}</div>
      </div>
    </section>
  )}

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline>
  (()=>{
    const body=document.getElementById('articleBody'),toast=document.getElementById('toast');
    const say=m=>{toast.textContent=m;toast.classList.add('show');clearTimeout(say.t);say.t=setTimeout(()=>toast.classList.remove('show'),1700)};
    const all=a=>[...document.querySelectorAll(`[data-action="${a}"]`)];

    // Text size: 16–25px, remembered; the stylesheet default applies until the reader changes it.
    let size=null;try{const s=+localStorage.getItem('nuvellum-font');if(s>=16&&s<=25)size=s}catch(e){}
    const applySize=()=>{if(size)body.style.fontSize=size+'px';const cur=size||parseFloat(getComputedStyle(body).fontSize);all('smaller').forEach(b=>b.disabled=cur<=16);all('larger').forEach(b=>b.disabled=cur>=25)};
    const step=d=>{size=Math.max(16,Math.min(25,Math.round((size||parseFloat(getComputedStyle(body).fontSize))+d)));try{localStorage.setItem('nuvellum-font',size)}catch(e){}applySize();say(`Text size ${size}px`)};
    applySize();

    // Save: same reading list as the homepage and earlier article pages.
    const key='nuvellum-saved-v2',title=document.getElementById('story-title').textContent.trim();
    const cat=document.querySelector('.opening-kicker .eyebrow').textContent.replace('✦','').trim()+' · '+document.querySelector('.opening-kicker .type').textContent.trim();
    const read=()=>{try{const l=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(l)?l:[]}catch(e){return[]}};
    const syncSave=()=>{const on=read().some(x=>x&&x.title===title);all('save').forEach(b=>{b.textContent=on?'Saved':'Save';b.setAttribute('aria-pressed',String(on));b.classList.toggle('on',on)})};
    const toggleSave=()=>{let l=read();const on=l.some(x=>x&&x.title===title);l=on?l.filter(x=>x&&x.title!==title):[...l,{title,cat,url:location.pathname}];try{localStorage.setItem(key,JSON.stringify(l))}catch(e){}syncSave();say(on?'Removed from your reading list.':'Saved to your reading list.')};
    syncSave();

    const copy=async()=>{try{await navigator.clipboard.writeText(location.href);say('Link copied.')}catch(e){say('Copy the address from your browser to share.')}};
    const share=async()=>{if(navigator.share){try{await navigator.share({title:document.title,url:location.href})}catch(e){}}else copy()};

    document.addEventListener('click',e=>{const b=e.target.closest?.('[data-action]');if(!b)return;const a=b.dataset.action;if(a==='smaller')step(-1);else if(a==='larger')step(1);else if(a==='save')toggleSave();else if(a==='share')share()});

    // Progress (article body to end of story), sticky reading strip after the byline.
    const bar=document.getElementById('readProgress'),pct=document.getElementById('readPct'),strip=document.getElementById('readingStrip');
    const end=document.querySelector('.story-end'),byline=document.getElementById('bylineRow');
    let queued=false;
    const update=()=>{queued=false;const top=body.getBoundingClientRect().top+scrollY,bottom=end.getBoundingClientRect().bottom+scrollY-innerHeight;const p=Math.max(0,Math.min(1,(scrollY-top+innerHeight*.35)/Math.max(1,bottom-top+innerHeight*.35)));bar.style.transform=`scaleX(${p})`;pct.textContent=Math.round(p*100)+'%';
      const show=byline.getBoundingClientRect().bottom<0;strip.classList.toggle('show',show);strip.setAttribute('aria-hidden',String(!show));strip.querySelectorAll('button,a').forEach(el=>el.tabIndex=show?0:-1)};
    addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(update)}},{passive:true});addEventListener('resize',update);update();

    // Table of contents: open beside the text on wide screens, collapsed above it on narrow ones.
    const toc=document.getElementById('toc');
    if(toc){
      const wide=matchMedia('(min-width: 1101px)');const syncToc=()=>{toc.open=wide.matches};syncToc();wide.addEventListener('change',syncToc);
      // The current section is the last heading above 35% of the viewport (works for short stories too).
      const links=[...toc.querySelectorAll('a')].map(a=>({a,h:document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)))})).filter(x=>x.h);
      let tq=false;
      const mark=()=>{tq=false;const line=innerHeight*.35;let cur=null;for(const x of links)if(x.h.getBoundingClientRect().top<line)cur=x;links.forEach(x=>{x.a.classList.toggle('active',x===cur);if(x===cur)x.a.setAttribute('aria-current','true');else x.a.removeAttribute('aria-current')})};
      addEventListener('scroll',()=>{if(!tq){tq=true;requestAnimationFrame(mark)}},{passive:true});mark();
      links.forEach(x=>x.a.addEventListener('click',()=>{if(!wide.matches)toc.open=false}));
    }
  })();
  </script>
</InteriorShell>
