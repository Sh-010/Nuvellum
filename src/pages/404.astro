---
import InteriorShell from '../components/InteriorShell.astro';
---
<InteriorShell title="Page not found — Nuvellum" description="The requested page could not be found.">
  <div class="int-wrap int-404">
    <div class="int-404-code" data-reveal>404</div>
    <div data-reveal>
      <div class="int-page-kicker">Missing page</div>
      <h1>This headline went missing.</h1>
      <p>The page may have moved, changed, or never existed. Return to the front page or continue through the latest edition.</p>
      <a class="int-action" href="/">Return to Nuvellum →</a>
      <a class="int-action" href="/latest" style="margin-left:20px">Read the latest →</a>
    </div>
  </div>
</InteriorShell>
