---
import InteriorShell from '../../components/InteriorShell.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getArticles, slugify } from '../../lib/articles';

export async function getStaticPaths(){
  const articles = await getArticles();
  const sections = [...new Set([...articles.map(a => slugify(a.section)), 'entertainment', 'crime'])];
  return sections.map(section => ({ params: { section } }));
}

const key = Astro.params.section!;
const all = (await getArticles()).filter(a =>
  slugify(a.section) === key || (key === 'entertainment' && ['anime','film-tv','gaming'].includes(slugify(a.section)))
);
const label = key === 'entertainment' ? 'Screen & Play' : key === 'crime' ? 'Crime' : (all[0]?.section || key.replace(/-/g,' ').replace(/\b\w/g,m=>m.toUpperCase()));
const lead = all[0];
const secondary = all.slice(1,3);
const rest = all.slice(3);
---
<InteriorShell
  title={`${label} — Nuvellum`}
  description={`Latest ${label} reporting and analysis from Nuvellum.`}
  active={key}
>
  <div class="int-wrap int-page">
    <header class="int-page-head" data-reveal>
      <div>
        <div class="int-page-kicker">Section</div>
        <h1 class="int-page-title">{label}</h1>
        <p class="int-page-dek">Reporting, analysis and ideas from Nuvellum’s {label} desk, arranged as an inside page rather than a feed of identical cards.</p>
      </div>
      <div class="int-page-note">{all.length} published {all.length === 1 ? 'story' : 'stories'} currently filed in this section.</div>
    </header>

    {lead ? (
      <>
        <section class="int-feature-grid" aria-label={`${label} lead stories`}>
          <StoryCard article={lead} variant="lead" />
          <div class="int-feature-side">
            {secondary.map(article => <StoryCard article={article} variant="compact" />)}
          </div>
        </section>

        {rest.length > 0 && (
          <section>
            <div class="int-section-label"><h2>More from {label}</h2><span>{rest.length} more</span></div>
            <div class="int-feed">
              {rest.map((article, index) => <StoryCard article={article} variant="row" index={index + 1} />)}
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="int-empty">No published Nuvellum stories are currently filed in {label}.</div>
    )}
  </div>
</InteriorShell>
