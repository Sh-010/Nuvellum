{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvellum.vercel.app/schemas/article-payload.schema.json",
  "title": "Nuvellum article ingestion payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "dek",
    "section",
    "type",
    "author",
    "date",
    "readingTime",
    "image",
    "imageAlt",
    "status",
    "tags",
    "sourceUrls",
    "origin",
    "risk",
    "bodyMarkdown"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180
    },
    "dek": {
      "type": "string",
      "minLength": 20,
      "maxLength": 360
    },
    "section": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "type": {
      "enum": [
        "News",
        "Analysis",
        "Opinion",
        "Review",
        "Explainer",
        "Essay",
        "Ideas"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "date": {
      "type": "string",
      "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}$"
    },
    "readingTime": {
      "type": "string",
      "pattern": "^[0-9]{1,3} min$"
    },
    "image": {
      "type": "string",
      "pattern": "^(?:/images/|/uploads/|https://)"
    },
    "imageAlt": {
      "type": "string",
      "minLength": 3,
      "maxLength": 220
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "uniqueItems": true
    },
    "sourceUrls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "sourceNote": {
      "type": "string",
      "maxLength": 500
    },
    "origin": {
      "enum": [
        "manual",
        "automation"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "sensitive"
      ]
    },
    "reviewedBy": {
      "type": "string",
      "maxLength": 100
    },
    "bodyMarkdown": {
      "type": "string",
      "minLength": 200
    }
  }
}
